// Driftwave's Full layout: the familiar look. A title bar of its own, the navigation pane, pages (Library,
// Discover, Search, Settings) on a content card, and the player card beside them. Coloured from the theme's tokens
// (fullpal.rs); drawn in vectors throughout.

export global Th {
    in-out property <color> background: #202020;
    in-out property <color> pane: #202020;
    in-out property <color> surface: #282828;
    in-out property <color> card: #2D2D2D;
    in-out property <color> card-stroke: #3A3A3A;
    in-out property <color> control: #353535;
    in-out property <color> control-stroke: #454545;
    in-out property <color> subtle: #FFFFFF0F;
    in-out property <color> divider: #FFFFFF14;
    // Text on the page; on cards; in the navigation pane and title bar; on buttons.
    in-out property <color> text: #FFFFFF;
    in-out property <color> text2: #C5C5C5;
    in-out property <color> text3: #9A9A9A;
    in-out property <color> card-text: #FFFFFF;
    in-out property <color> card-text2: #C5C5C5;
    in-out property <color> pane-text: #FFFFFF;
    in-out property <color> title-text: #FFFFFF;
    in-out property <color> control-text: #FFFFFF;
    in-out property <color> accent: #4CC2FF;
    in-out property <color> accent-text: #99EBFF;
    in-out property <color> on-accent: #000000;
    in-out property <color> dialog: #2B2B2B;
    in-out property <string> body-font: "Segoe UI";
    in-out property <string> title-font: "Segoe UI";
    in-out property <length> title-size: 28px;
    in-out property <int> title-weight: 600;
    // The window's own title ("windowTitle"); page titles' case, spacing and glow ("titleShadow").
    in-out property <string> window-title-font: "Segoe UI";
    in-out property <length> window-title-size: 12px;
    in-out property <int> window-title-weight: 400;
    in-out property <color> window-title-color: #FFFFFF;
    in-out property <bool> title-upper: false;
    in-out property <length> title-spacing: 0px;
    in-out property <bool> title-glows: false;
    in-out property <color> title-glow: transparent;
    in-out property <length> title-glow-reach: 8px;
    // Neon tubes round the page and the player ("neonEdges").
    in-out property <bool> neon-content-on: false;
    in-out property <color> neon-content: transparent;
    in-out property <bool> neon-player-on: false;
    in-out property <color> neon-player: transparent;
    in-out property <length> neon-reach: 16px;
    in-out property <float> neon-opacity: 0.8;
    in-out property <bool> window-title-upper: false;
    // A hard shadow behind page titles (titleShadow with no blur), and a block cursor after them.
    in-out property <bool> title-hard: false;
    in-out property <length> title-hard-x: 3px;
    in-out property <length> title-hard-y: 3px;
    in-out property <bool> title-cursor: false;
    in-out property <color> title-cursor-color: #FFFFFF;
    // A thick screen border round the window ("frame").
    in-out property <bool> frame-on: false;
    in-out property <color> frame-color: #000080;
    in-out property <length> frame-thickness: 4px;
    in-out property <length> radius-card: 8px;
    in-out property <length> radius-control: 4px;
    in-out property <length> radius-cover: 10px;
}


// A theme's text in its scene (the title bar's sign, say): where it sits in its region, as a share of the
// region's size plus px.
export struct SceneText {
    text: string,
    region: string,
    xf: float,
    x: length,
    yf: float,
    y: length,
    size: length,
    ink: color,
    family: string,
    weight: int,
    italic: bool,
    glows: bool,
    glow: color,
    reach: length,
}

// The theme's scene behind everything (scene.rs paints it): the still backdrop, and what moves on top of it.
export global Scenery {
    in property <bool> on;
    in property <image> back;
    in property <bool> moving;
    in property <image> motion;
    in property <[SceneText]> texts;
    // What lies over everything (grain, vignette, scanlines): one still, mostly clear picture.
    in property <bool> front-on;
    in property <image> front;
    // Synthwave's rows rolling towards you (phase 0–1), the scanlines' slow band, and Stealth's spotlight.
    in property <bool> synth-on;
    in property <color> synth-grid: #FF2E97;
    in property <float> synth-phase;
    in property <bool> band-on;
    in property <length> band-y: -400px;
    in property <bool> spot-on;
    in property <length> spot-x;
    in property <length> spot-y;
    in property <length> spot-radius: 360px;
    in property <float> spot-opacity: 0.6;
    // The person's choice: scenes that move, or hold still.
    in property <bool> motion-on: true;
    callback motion-chosen(bool);
}

// Text that can glow like neon: a tight halo of copies hugging the letters and a soft haze behind them.
component GlowText inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    in property <bool> glows;
    in property <color> glow;
    in property <length> reach: 6px;
    in property <string> family;
    in property <length> size: 14px;
    in property <int> weight: 400;
    in property <length> spacing: 0px;
    in property <bool> upper;
    in property <bool> italic;
    in property <bool> hard;
    in property <length> hard-x: 3px;
    in property <length> hard-y: 3px;
    in property <bool> cursor;
    in property <color> cursor-color: root.ink;
    property <string> shown: root.upper ? root.text.to-uppercase() : root.text;
    width: label.preferred-width + (root.cursor ? root.size * 0.75 : 0px);
    height: label.preferred-height;
    if root.hard: Text {
        x: root.hard-x; y: root.hard-y;
        text: root.shown; color: root.glow; font-italic: root.italic;
        font-family: root.family; font-size: root.size; font-weight: root.weight; letter-spacing: root.spacing;
    }
    if root.glows: Rectangle {
        x: root.size * 0.1; y: root.height * 0.28; width: root.width - root.size * 0.2; height: root.height * 0.5;
        border-radius: self.height / 2;
        background: root.glow.transparentize(0.93);
        drop-shadow-blur: root.reach * 1.6;
        drop-shadow-color: root.glow.transparentize(0.72);
    }
    if root.glows: Rectangle {
        for k in 20: Text {
            property <bool> inner: k < 8;
            property <angle> a: inner ? k * 45deg : (k - 8) * 30deg + 15deg;
            property <length> r: inner ? min(1.2px, root.reach * 0.2) : min(2.8px, root.reach * 0.45);
            x: r * cos(a);
            y: r * sin(a);
            text: root.shown; font-italic: root.italic;
            color: root.glow.transparentize(inner ? 0.55 : 0.8);
            font-family: root.family; font-size: root.size; font-weight: root.weight; letter-spacing: root.spacing;
        }
    }
    label := Text {
        x: 0; y: 0;
        text: root.shown; color: root.ink; font-italic: root.italic;
        font-family: root.family; font-size: root.size; font-weight: root.weight; letter-spacing: root.spacing;
    }
    // A solid block cursor after the title (never blinking: nothing in Driftwave flashes).
    if root.cursor: Rectangle {
        x: label.preferred-width + root.size * 0.18; y: root.height * 0.18;
        width: root.size * 0.5; height: root.height * 0.66;
        background: root.cursor-color;
    }
}

// A page's title, in the theme's title font and treatment.
component PageTitle inherits GlowText {
    ink: Th.text;
    glows: Th.title-glows;
    glow: Th.title-glow;
    reach: Th.title-glow-reach;
    family: Th.title-font;
    size: Th.title-size;
    weight: Th.title-weight;
    spacing: Th.title-spacing;
    upper: Th.title-upper;
    hard: Th.title-hard;
    hard-x: Th.title-hard-x;
    hard-y: Th.title-hard-y;
    cursor: Th.title-cursor;
    cursor-color: Th.title-cursor-color;
}


export struct StationCard {
    name: string,
    detail: string,
    playing: bool,
    cover: image,
    has-cover: bool,
    small: bool,
    c1: color,
    c2: color,
}

export struct TrackRow {
    title: string,
    note: string,
}

export struct Swatch {
    id: string,
    name: string,
    back: color,
    card: color,
    accent: color,
    text: color,
    on: bool,
}

// A station's picture: its logo, or a soft two-colour tile with an antenna.
component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has-source;
    // A small logo (under 128 px) is shown at a size it can carry, centred on its tile, not blown up.
    in property <bool> small;
    in property <color> c1: #6B4EA0;
    in property <color> c2: #C24F8E;
    border-radius: Th.radius-cover;
    clip: true;
    background: has-source && !small ? #00000000 : @linear-gradient(135deg, c1 0%, c2 100%);
    if has-source && !small: Image { width: parent.width; height: parent.height; source: root.source; image-fit: cover; image-rendering: smooth; }
    if has-source && small: Rectangle {
        width: min(parent.width * 0.62, root.source.width * 1.15px); height: self.width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        border-radius: self.width * 0.12; clip: true; background: #FFFFFF;
        Image { width: parent.width; height: parent.height; source: root.source; image-fit: contain; image-rendering: smooth; }
    }
    if !has-source: Path {
        x: parent.width * 0.32; y: parent.height * 0.3; width: parent.width * 0.36; height: parent.height * 0.4;
        viewbox-width: 24; viewbox-height: 26; fill: transparent; stroke: #FFFFFFE0; stroke-width: max(1.5px, parent.width / 70);
        commands: "M 12 10 L 5 26 M 12 10 L 19 26 M 7.5 20 L 16.5 20 M 6 4 Q 2.5 8 6 12 M 18 4 Q 21.5 8 18 12 M 3 1 Q -2 8 3 15 M 21 1 Q 26 8 21 15 M 12 7 L 12 10";
    }
}

// A navigation pane item: icon, label, and the accent pill when selected.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    callback clicked();
    height: 36px;
    border-radius: Th.radius-control;
    background: selected ? Th.subtle : (ta.has-hover ? Th.subtle.transparentize(40%) : transparent);
    ta := TouchArea { clicked => { root.clicked(); } }
    if selected: Rectangle { x: 0; y: 10px; width: 3px; height: 16px; border-radius: 1.5px; background: Th.accent; }
    Path {
        x: 14px; y: 10px; width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
        fill: transparent; stroke: Th.pane-text; stroke-width: 1.3px; commands: root.icon;
    }
    Text { x: 42px; y: (parent.height - self.height) / 2; text: root.label; color: Th.pane-text; font-size: 13px; }
}

// A plain button in the theme's control colours.
component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    height: 32px;
    width: max(80px, label.preferred-width + 24px);
    border-radius: Th.radius-control;
    background: primary ? (ta.pressed ? Th.accent.darker(15%) : (ta.has-hover ? Th.accent.brighter(8%) : Th.accent))
        : (ta.pressed ? Th.control.darker(10%) : (ta.has-hover ? Th.control.brighter(6%) : Th.control));
    border-width: 1px;
    border-color: primary ? Th.accent.darker(10%) : Th.control-stroke;
    ta := TouchArea { clicked => { root.clicked(); } }
    label := Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: root.text; color: primary ? Th.on-accent : Th.control-text; font-size: 13px; }
}

// A round button with a vector glyph (the player's play / stop).
component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> primary;
    callback clicked();
    width: 44px; height: 44px; border-radius: self.width / 2;
    background: primary ? (ta.pressed ? Th.accent.darker(15%) : (ta.has-hover ? Th.accent.brighter(8%) : Th.accent))
        : (ta.has-hover ? Th.subtle : transparent);
    ta := TouchArea { clicked => { root.clicked(); } }
    Path {
        x: parent.width * 0.32; y: parent.height * 0.32; width: parent.width * 0.36; height: parent.height * 0.36;
        viewbox-width: 16; viewbox-height: 16; stroke: transparent; fill: primary ? Th.on-accent : Th.card-text;
        commands: root.glyph;
    }
}

// The window's caption buttons, drawn for the theme.
component Caption inherits Rectangle {
    in property <string> glyph; // min, max, restore, close
    callback clicked();
    width: 46px; height: 48px;
    background: ta.has-hover ? (glyph == "close" ? #C42B1C : Th.subtle) : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Path {
        x: (parent.width - 10px) / 2; y: (parent.height - 10px) / 2; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10;
        fill: transparent; stroke: (ta.has-hover && glyph == "close") ? #FFFFFF : Th.title-text; stroke-width: 1px;
        commands: glyph == "min" ? "M 0 5 L 10 5" : glyph == "max" ? "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
            : glyph == "restore" ? "M 2.5 2.5 L 9.5 2.5 L 9.5 9.5 L 2.5 9.5 Z M 0.5 2 L 0.5 0.5 L 8 0.5" : "M 0 0 L 10 10 M 10 0 L 0 10";
    }
}

// A settings card: a heading, a line of explanation, and its controls.
component SettingsCard inherits Rectangle {
    in property <string> heading;
    in property <string> note;
    border-radius: Th.radius-card;
    background: Th.card;
    border-width: 1px;
    border-color: Th.card-stroke;
    VerticalLayout {
        padding: 16px; spacing: 10px;
        Text { text: root.heading; color: Th.card-text; font-size: 14px; font-weight: 600; }
        if root.note != "": Text { text: root.note; color: Th.card-text2; font-size: 12px; wrap: word-wrap; }
        @children
    }
}

// A station's details, for the dialog.
export struct Details {
    name: string,
    subtitle: string,
    tags: string,
    location: string,
    language: string,
    codec: string,
    votes: string,
    homepage: string,
    stream: string,
    in-library: bool,
    local: bool,
    orphaned: bool,
    playing: bool,
    cover: image,
    has-cover: bool,
    small: bool,
    c1: color,
    c2: color,
}

// Finding stations (Discover, Search), a station's details, adding your own, importing and exporting.
// Rust talks to this directly (ui.global::<Dir>()).
export global Dir {
    in property <[StationCard]> discover;
    in property <[StationCard]> results;
    in property <string> discover-mode: "popular"; // popular, trending, random
    in property <[string]> countries;
    in property <int> country: -1;
    in property <int> search-country: -1;
    in property <[string]> languages;
    in property <int> language: -1;
    in property <[string]> tags;
    in property <int> tag: -1;
    in property <[string]> orders: ["Most Voted", "Most Played", "Name", "Bitrate", "Random"];
    in property <int> order: 0;
    in property <string> discover-status;
    in property <string> search-status;
    in property <bool> details-open;
    in property <Details> details;
    in-out property <bool> add-open;
    in property <string> add-error;
    in property <string> add-cover;
    in property <string> message;
    callback discover-mode-chosen(string);
    callback country-chosen(int);
    callback discover-refresh();
    callback search(string);
    callback filter-chosen(string, int);
    callback open(string, int);      // "library", "discover" or "search", and the card
    callback play-now(string, int);
    callback details-play();
    callback details-library();
    callback details-homepage();
    callback details-close();
    callback add-local(string, string);
    callback choose-cover();
    callback import-stations();
    callback export-stations();
    callback dismiss();
}

// A grid of station cards: click for details, double-click (or the round button) to play.
component StationGrid inherits Flickable {
    in property <[StationCard]> cards;
    in property <int> selected: -1;
    callback open(int);
    callback play(int);
    property <length> cw: 164px;
    property <length> ch: 214px;
    property <length> gap: 8px;
    property <int> cols: max(1, Math.floor((self.width + gap) / (cw + gap)));
    content-height: Math.ceil(root.cards.length / cols) * (ch + gap);
    for s[i] in root.cards: Rectangle {
        x: Math.mod(i, root.cols) * (root.cw + root.gap);
        y: Math.floor(i / root.cols) * (root.ch + root.gap);
        width: root.cw; height: root.ch;
        border-radius: Th.radius-card;
        background: i == root.selected ? Th.subtle : (card-ta.has-hover ? Th.subtle.transparentize(40%) : transparent);
        card-ta := TouchArea {
            clicked => { root.open(i); }
            double-clicked => { root.play(i); }
        }
        Cover { x: 8px; y: 8px; width: 148px; height: 148px; source: s.cover; has-source: s.has-cover; small: s.small; c1: s.c1; c2: s.c2; }
        if s.playing || card-ta.has-hover: Rectangle {
            x: 122px; y: 122px; width: 30px; height: 30px; border-radius: 15px;
            background: play-ta.has-hover ? Th.accent.brighter(10%) : Th.accent;
            play-ta := TouchArea { clicked => { root.play(i); } }
            Path { x: 10px; y: 8px; width: 12px; height: 14px; viewbox-width: 12; viewbox-height: 14; stroke: transparent; fill: Th.on-accent;
                commands: s.playing ? "M 1 1 L 4.5 1 L 4.5 13 L 1 13 Z M 7.5 1 L 11 1 L 11 13 L 7.5 13 Z" : "M 1 0 L 12 7 L 1 14 Z"; }
        }
        Text { x: 10px; y: 164px; width: parent.width - 20px; text: s.name; color: Th.text; font-size: 13px; font-weight: 600; overflow: elide; }
        Text { x: 10px; y: 184px; width: parent.width - 20px; text: s.detail; color: Th.text2; font-size: 11px; overflow: elide; }
    }
}

// A dropdown: the current choice, and a list to pick from.
component Picker inherits Rectangle {
    in property <[string]> options;
    in property <int> current: -1;
    in property <string> placeholder: "Any";
    callback chosen(int);
    height: 32px;
    width: max(130px, value.preferred-width + 44px);
    border-radius: Th.radius-control;
    background: ta.has-hover ? Th.control.brighter(6%) : Th.control;
    border-width: 1px;
    border-color: Th.control-stroke;
    ta := TouchArea { clicked => { pop.show(); } }
    value := Text { x: 12px; y: (parent.height - self.height) / 2; color: Th.control-text; font-size: 13px;
        text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : root.placeholder; }
    Path { x: parent.width - 22px; y: 13px; width: 10px; height: 6px; viewbox-width: 10; viewbox-height: 6; fill: transparent;
        stroke: Th.control-text; stroke-width: 1.3px; commands: "M 1 1 L 5 5 L 9 1"; }
    pop := PopupWindow {
        x: 0; y: root.height + 4px; width: max(240px, root.width); height: min(360px, (root.options.length + 1) * 30px + 8px);
        Rectangle {
            background: Th.dialog; border-radius: Th.radius-control; border-width: 1px; border-color: Th.card-stroke;
            Flickable {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                content-height: (root.options.length + 1) * 30px;
                Rectangle {
                    y: 0; height: 30px; border-radius: Th.radius-control; background: any-ta.has-hover ? Th.subtle : transparent;
                    any-ta := TouchArea { clicked => { root.chosen(-1); } }
                    Text { x: 10px; y: (parent.height - self.height) / 2; text: root.placeholder; color: Th.card-text2; font-size: 13px; }
                }
                for o[i] in root.options: Rectangle {
                    y: (i + 1) * 30px; height: 30px; border-radius: Th.radius-control; background: opt-ta.has-hover ? Th.subtle : transparent;
                    opt-ta := TouchArea { clicked => { root.chosen(i); } }
                    Text { x: 10px; y: (parent.height - self.height) / 2; width: parent.width - 20px; text: o; overflow: elide;
                        color: i == root.current ? Th.accent-text : Th.card-text; font-size: 13px; }
                }
            }
        }
    }
}

// A text field in the theme's colours.
component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback accepted(string);
    height: 32px;
    border-radius: Th.radius-control;
    background: Th.control;
    border-width: 1px;
    border-color: input.has-focus ? Th.accent : Th.control-stroke;
    if input.text == "": Text { x: 10px; y: (parent.height - self.height) / 2; text: root.placeholder; color: Th.control-text.transparentize(45%); font-size: 13px; }
    input := TextInput {
        x: 10px; y: (parent.height - self.height) / 2; width: parent.width - 20px;
        single-line: true; color: Th.control-text; font-size: 13px;
        accepted => { root.accepted(self.text); }
    }
}

// A row of the details dialog: a label and its value.
component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: value == "" ? 0px : 22px;
    visible: value != "";
    Text { x: 0; width: 96px; text: root.label; color: Th.card-text2; font-size: 12px; }
    Text { x: 100px; width: parent.width - 100px; text: root.value; color: Th.card-text; font-size: 12px; overflow: elide; }
}

export component FullView inherits Rectangle {
    // Now playing and the library (shared with Classic through the window).
    in property <[StationCard]> stations;
    in-out property <int> selected: -1;
    in property <string> station;
    in property <string> song;
    in property <string> artist;
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> cover-small;
    in property <color> cover-c1;
    in property <color> cover-c2;
    in property <bool> playing;
    in property <bool> loading;
    in property <string> status;
    in-out property <float> volume;
    in property <[TrackRow]> tracks;
    in property <bool> recording;
    in property <bool> record-armed;
    in property <string> sort-name: "Name";
    in property <bool> maximized;
    in property <bool> active: true;
    in property <string> version;

    // Settings.
    in property <[Swatch]> themes;
    in property <string> appearance: "system"; // system, light, dark

    in-out property <string> page: "library";
    in-out property <bool> show-player: true;

    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback quit();
    callback resize-edge(string);
    callback play-station(int);
    callback play();
    callback stop();
    callback volume-changed(float);
    callback toggle-record();
    callback to-classic();
    callback cycle-sort();
    callback choose-theme(string);
    callback choose-appearance(string);

    background: Th.background;
    property <length> pane-w: 220px;
    property <length> title-h: 48px;
    out property <length> title-end: window-title.x + window-title.width;

    if Scenery.on: Image { x: 0; y: 0; width: parent.width; height: parent.height; source: Scenery.back; image-fit: fill; }
    if Scenery.on && Scenery.moving: Image {
        x: 0; y: 0; width: parent.width; height: parent.height; source: Scenery.motion; image-fit: fill; image-rendering: smooth;
    }
    property <length> player-w: show-player ? 312px : 0px;

    // Synthwave's rows, rolling towards you over the floor (the sky, sun and floor are the backdrop's).
    if Scenery.synth-on: Rectangle {
        property <length> horizon: root.height * 0.6;
        for i in 16: Rectangle {
            property <float> depth: i + 1 - Scenery.synth-phase;
            property <length> at: parent.horizon + (root.height - parent.horizon) / (1 + 0.55 * self.depth);
            x: 0; y: self.at - 0.7px; width: root.width; height: 1.4px;
            background: Scenery.synth-grid.transparentize(1 - clamp((self.at - parent.horizon) / (root.height - parent.horizon) * 3, 0, 1));
        }
    }

    // Theme text in the window, the pane or the player's area.
    for t in Scenery.texts: GlowText {
        property <length> rx: t.region == "pane" ? 0px : t.region == "player" ? root.width - root.player-w : 0px;
        property <length> ry: t.region == "window" ? 0px : root.title-h;
        property <length> rw: t.region == "pane" ? root.pane-w : t.region == "player" ? root.player-w : root.width;
        property <length> rh: t.region == "window" ? root.height : root.height - root.title-h;
        visible: t.region == "window" || t.region == "pane" || t.region == "player";
        x: self.rx + self.rw * t.xf + t.x;
        y: self.ry + self.rh * t.yf + t.y;
        text: t.text; ink: t.ink; glows: t.glows; glow: t.glow; reach: t.reach; italic: t.italic;
        family: t.family; size: t.size; weight: t.weight;
    }

    // ─────────── Title bar ───────────
    Rectangle {
        x: 0; y: 0; width: parent.width; height: root.title-h;
        TouchArea {
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.drag(); } }
            double-clicked => { root.toggle-maximize(); }
        }
        // The Driftwave sun.
        Rectangle {
            x: 14px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; border-radius: 8px; clip: true;
            background: @linear-gradient(180deg, #FFD36E 0%, #FF8A70 55%, #FF6FA8 100%);
            for k in 3: Rectangle { y: (8.5 + k * 2.4) * 1px; height: 1.2px; background: Th.background; }
        }
        window-title := Text {
            x: 40px; y: (parent.height - self.height) / 2; text: Th.window-title-upper ? "DRIFTWAVE" : "Driftwave";
            color: root.active ? Th.window-title-color : Th.window-title-color.transparentize(40%);
            font-family: Th.window-title-font; font-size: Th.window-title-size; font-weight: Th.window-title-weight;
        }
        for t in Scenery.texts: GlowText {
            property <length> x0: window-title.x + window-title.width + 16px;
            visible: t.region == "titlebar";
            x: self.x0 + (parent.width - 150px - self.x0) * t.xf + t.x;
            y: parent.height * t.yf + t.y;
            text: t.text; ink: t.ink; glows: t.glows; glow: t.glow; reach: t.reach; italic: t.italic;
            family: t.family; size: t.size; weight: t.weight;
        }
        Caption { x: parent.width - 138px; y: 0; glyph: "min"; clicked => { root.minimize(); } }
        Caption { x: parent.width - 92px; y: 0; glyph: root.maximized ? "restore" : "max"; clicked => { root.toggle-maximize(); } }
        Caption { x: parent.width - 46px; y: 0; glyph: "close"; clicked => { root.quit(); } }
    }

    // ─────────── Navigation ───────────
    Rectangle {
        x: 0; y: root.title-h; width: pane-w; height: parent.height - root.title-h; background: Th.pane;
        VerticalLayout {
            padding: 6px; spacing: 2px;
            NavItem { label: "Library"; selected: root.page == "library"; clicked => { root.page = "library"; }
                icon: "M 2 2 L 2 14 M 5 2 L 5 14 M 8.5 2.5 L 11.5 13.5 M 11 2 L 14 13"; }
            NavItem { label: "Discover"; selected: root.page == "discover"; clicked => { root.page = "discover"; }
                icon: "M 8 1.5 A 6.5 6.5 0 1 1 7.99 1.5 Z M 10.5 5.5 L 9 9 L 5.5 10.5 L 7 7 Z"; }
            NavItem { label: "Search"; selected: root.page == "search"; clicked => { root.page = "search"; }
                icon: "M 6.5 2 A 4.5 4.5 0 1 1 6.49 2 Z M 9.8 9.8 L 14 14"; }
            Rectangle { }
            NavItem { label: root.show-player ? "Hide Player" : "Show Player"; clicked => { root.show-player = !root.show-player; }
                icon: "M 1.5 2.5 L 14.5 2.5 L 14.5 13.5 L 1.5 13.5 Z M 10 2.5 L 10 13.5"; }
            NavItem { label: "Classic Mode"; clicked => { root.to-classic(); }
                icon: "M 2 1.5 L 14 1.5 L 14 6 L 2 6 Z M 2 7.5 L 14 7.5 L 14 10.5 L 2 10.5 Z M 2 12 L 14 12 L 14 14.5 L 2 14.5 Z"; }
            NavItem { label: "Settings"; selected: root.page == "settings"; clicked => { root.page = "settings"; }
                icon: "M 8 5 A 3 3 0 1 1 7.99 5 Z M 8 1 L 8 3 M 8 13 L 8 15 M 1 8 L 3 8 M 13 8 L 15 8 M 3 3 L 4.4 4.4 M 11.6 11.6 L 13 13 M 13 3 L 11.6 4.4 M 4.4 11.6 L 3 13"; }
        }
    }

    // ─────────── The content card ───────────
    Rectangle {
        x: pane-w; y: root.title-h; width: parent.width - pane-w; height: parent.height - root.title-h;
        border-radius: Th.radius-card;
        background: Th.surface;
        border-width: Th.neon-content-on ? 2px : 1px;
        border-color: Th.neon-content-on ? Th.neon-content : Th.card-stroke;
        clip: true;
        // The tube's white-hot core.
        if Th.neon-content-on: Rectangle {
            x: 0.6px; y: 0.6px; width: parent.width - 1.2px; height: parent.height - 1.2px;
            border-width: 0.75px; border-radius: max(0px, Th.radius-card - 0.6px); border-color: Th.neon-content.mix(#FFFFFF, 0.25);
        }

        // Theme text in the page's scene.
        for t in Scenery.texts: GlowText {
            visible: t.region == "content";
            x: (parent.width - root.player-w) * t.xf + t.x;
            y: parent.height * t.yf + t.y;
            text: t.text; ink: t.ink; glows: t.glows; glow: t.glow; reach: t.reach; italic: t.italic;
            family: t.family; size: t.size; weight: t.weight;
        }

        // Library.
        if root.page == "library": Rectangle {
            x: 0; y: 0; width: parent.width - root.player-w; height: parent.height;
            PageTitle { x: 28px; y: 22px; text: "Library"; }
            Btn { x: parent.width - self.width - 64px; y: 26px; text: "↕  " + root.sort-name; clicked => { root.cycle-sort(); } }
            Btn {
                x: parent.width - 56px; y: 26px; width: 32px; text: "···";
                clicked => { library-menu.show(); }
                library-menu := PopupWindow {
                    x: -180px; y: 36px; width: 212px; height: 3 * 32px + 8px;
                    Rectangle {
                        background: Th.dialog; border-radius: Th.radius-control; border-width: 1px; border-color: Th.card-stroke;
                        VerticalLayout {
                            padding: 4px;
                            for item[i] in ["Add Local Station…", "Import Stations…", "Export Stations…"]: Rectangle {
                                height: 32px; border-radius: Th.radius-control; background: menu-ta.has-hover ? Th.subtle : transparent;
                                menu-ta := TouchArea {
                                    clicked => {
                                        if (i == 0) { Dir.add-open = true; }
                                        if (i == 1) { Dir.import-stations(); }
                                        if (i == 2) { Dir.export-stations(); }
                                    }
                                }
                                Text { x: 12px; y: (parent.height - self.height) / 2; text: item; color: Th.card-text; font-size: 13px; }
                            }
                        }
                    }
                }
            }
            if root.stations.length == 0: VerticalLayout {
                x: 0; y: 120px; width: parent.width; height: 200px; spacing: 10px; alignment: center;
                Text { text: "Your Library Is Empty"; color: Th.text; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
                Text { text: "Discover stations and add the ones you like."; color: Th.text2; font-size: 13px; horizontal-alignment: center; }
            }
            StationGrid {
                x: 20px; y: 80px; width: parent.width - 40px; height: parent.height - 92px;
                cards: root.stations; selected: root.selected;
                open(i) => { root.selected = i; Dir.open("library", i); }
                play(i) => { root.selected = i; root.play-station(i); }
            }
        }

        // Discover: popular stations where you are, trending worldwide, or a random handful.
        if root.page == "discover": Rectangle {
            x: 0; y: 0; width: parent.width - root.player-w; height: parent.height;
            PageTitle { x: 28px; y: 22px; text: "Discover"; }
            HorizontalLayout {
                x: 28px; y: 76px; height: 32px; spacing: 8px; alignment: start;
                Btn { text: "Popular"; primary: Dir.discover-mode == "popular"; clicked => { Dir.discover-mode-chosen("popular"); } }
                Btn { text: "Trending"; primary: Dir.discover-mode == "trending"; clicked => { Dir.discover-mode-chosen("trending"); } }
                Btn { text: "Random"; primary: Dir.discover-mode == "random"; clicked => { Dir.discover-mode-chosen("random"); } }
                if Dir.discover-mode != "trending": Picker {
                    options: Dir.countries; current: Dir.country; placeholder: "Any country";
                    chosen(i) => { Dir.country-chosen(i); }
                }
                Btn { text: "Refresh"; clicked => { Dir.discover-refresh(); } }
            }
            if Dir.discover-status != "": Text { x: 28px; y: 124px; text: Dir.discover-status; color: Th.text2; font-size: 13px; }
            StationGrid {
                x: 20px; y: 124px; width: parent.width - 40px; height: parent.height - 136px;
                cards: Dir.discover;
                open(i) => { Dir.open("discover", i); }
                play(i) => { Dir.play-now("discover", i); }
            }
        }

        // Search: by name, filtered by country, language and tag, sorted.
        if root.page == "search": Rectangle {
            x: 0; y: 0; width: parent.width - root.player-w; height: parent.height;
            PageTitle { x: 28px; y: 22px; text: "Search"; }
            search-box := Field {
                x: 28px; y: 76px; width: min(420px, parent.width - 56px); placeholder: "Station name";
                accepted(t) => { Dir.search(t); }
            }
            search-go := Btn { x: search-box.x + search-box.width + 8px; y: 76px; text: "Search"; primary: true; clicked => { Dir.search(search-box.text); } }
            Picker { x: search-go.x + search-go.width + 8px; y: 76px; options: Dir.orders; current: Dir.order; placeholder: "Most Voted";
                chosen(i) => { Dir.filter-chosen("order", i); } }
            HorizontalLayout {
                x: 28px; y: 116px; height: 32px; spacing: 8px; alignment: start;
                Picker { options: Dir.countries; current: Dir.search-country; placeholder: "Any country"; chosen(i) => { Dir.filter-chosen("country", i); } }
                Picker { options: Dir.languages; current: Dir.language; placeholder: "Any language"; chosen(i) => { Dir.filter-chosen("language", i); } }
                Picker { options: Dir.tags; current: Dir.tag; placeholder: "Any tag"; chosen(i) => { Dir.filter-chosen("tag", i); } }
            }
            if Dir.search-status != "": Text { x: 28px; y: 164px; text: Dir.search-status; color: Th.text2; font-size: 13px; }
            StationGrid {
                x: 20px; y: 164px; width: parent.width - 40px; height: parent.height - 176px;
                cards: Dir.results;
                open(i) => { Dir.open("search", i); }
                play(i) => { Dir.play-now("search", i); }
            }
        }

        // Settings.
        if root.page == "settings": Flickable {
            x: 0; y: 0; width: parent.width - root.player-w; height: parent.height;
            content-height: settings-col.preferred-height + 40px;
            settings-col := VerticalLayout {
                x: 28px; y: 22px; width: parent.width - 56px; spacing: 12px; alignment: start;
                HorizontalLayout { alignment: start; PageTitle { text: "Settings"; } }
                SettingsCard {
                    heading: "Layout";
                    note: "Full is everything; Classic is the compact player of the Winamp years. Swap any time: the music carries on.";
                    HorizontalLayout {
                        spacing: 10px; alignment: start;
                        Btn { text: "Full"; primary: true; }
                        Btn { text: "Classic"; clicked => { root.to-classic(); } }
                    }
                }
                SettingsCard {
                    heading: "App theme";
                    note: "Light or dark for the Default theme.";
                    HorizontalLayout {
                        spacing: 10px; alignment: start;
                        Btn { text: "Use system setting"; primary: root.appearance == "system"; clicked => { root.choose-appearance("system"); } }
                        Btn { text: "Light"; primary: root.appearance == "light"; clicked => { root.choose-appearance("light"); } }
                        Btn { text: "Dark"; primary: root.appearance == "dark"; clicked => { root.choose-appearance("dark"); } }
                    }
                }
                SettingsCard {
                    heading: "Moving scenes";
                    note: "Some themes have a scene that moves, like rain on the glass and people passing by. It moves only while Driftwave is in front, and holds still by itself if it would slow this computer down.";
                    HorizontalLayout {
                        spacing: 10px; alignment: start;
                        Btn { text: "Moving"; primary: Scenery.motion-on; clicked => { Scenery.motion-chosen(true); } }
                        Btn { text: "Still"; primary: !Scenery.motion-on; clicked => { Scenery.motion-chosen(false); } }
                    }
                }
                SettingsCard {
                    heading: "Theme";
                    note: "A look for the whole app, in both layouts.";
                    gallery := Rectangle {
                        property <int> cols: max(1, Math.floor((self.width + 8px) / 120px));
                        height: Math.ceil(root.themes.length / cols) * 96px;
                        for t[i] in root.themes: Rectangle {
                            x: Math.mod(i, gallery.cols) * 120px; y: Math.floor(i / gallery.cols) * 96px; width: 112px; height: 88px;
                            border-radius: Th.radius-control;
                            border-width: t.on ? 2px : 1px;
                            border-color: t.on ? Th.accent : (sw-ta.has-hover ? Th.text3 : Th.card-stroke);
                            background: t.back;
                            clip: true;
                            sw-ta := TouchArea { clicked => { root.choose-theme(t.id); } }
                            Rectangle { x: 10px; y: 10px; width: 60px; height: 34px; border-radius: 4px; background: t.card;
                                Text { x: 8px; y: 6px; text: "Aa"; color: t.text; font-size: 15px; font-weight: 700; } }
                            Rectangle { x: 76px; y: 12px; width: 26px; height: 8px; border-radius: 4px; background: t.accent; }
                            Rectangle { x: 76px; y: 26px; width: 18px; height: 8px; border-radius: 4px; background: t.text.transparentize(60%); }
                            Rectangle { x: 0; y: 54px; width: parent.width; height: 34px; background: #00000066;
                                Text { x: 8px; y: (parent.height - self.height) / 2; width: parent.width - 16px; text: t.name; color: #FFFFFF; font-size: 11px; overflow: elide; } }
                        }
                    }
                }
                SettingsCard {
                    heading: "About";
                    note: "Driftwave " + root.version + ". Internet radio, one app, written in Rust. Made with Slint.";
                }
            }
        }

        // ─────────── The player card ───────────
        if root.show-player: Rectangle {
            x: parent.width - root.player-w; y: 0; width: root.player-w; height: parent.height;
            Rectangle {
                x: 4px; y: 8px; width: 300px; height: parent.height - 16px;
                border-radius: Th.radius-card; background: Th.card; clip: true;
                border-width: Th.neon-player-on ? 2px : 1px;
                border-color: Th.neon-player-on ? Th.neon-player : Th.card-stroke;
                if Th.neon-player-on: Rectangle {
                    x: 0.6px; y: 0.6px; width: parent.width - 1.2px; height: parent.height - 1.2px;
                    border-width: 0.75px; border-radius: max(0px, Th.radius-card - 0.6px); border-color: Th.neon-player.mix(#FFFFFF, 0.25);
                }
                if root.station == "": VerticalLayout {
                    alignment: center; spacing: 8px; padding: 24px;
                    Text { text: "No Playback"; color: Th.card-text; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                    Text { text: "Choose a station from your library."; color: Th.card-text2; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                }
                if root.station != "": Rectangle {
                    Cover { x: 30px; y: 24px; width: 240px; height: 240px; source: root.cover; has-source: root.has-cover; small: root.cover-small; c1: root.cover-c1; c2: root.cover-c2; }
                    Text { x: 20px; y: 280px; width: parent.width - 40px; text: root.station; color: Th.card-text; font-size: 17px; font-weight: 600;
                        horizontal-alignment: center; wrap: word-wrap; max-height: 48px; overflow: elide; }
                    Text { x: 20px; y: 330px; width: parent.width - 40px; text: root.song != "" ? root.song : root.status; color: Th.card-text; font-size: 13px; font-weight: 600;
                        horizontal-alignment: center; overflow: elide; }
                    Text { x: 20px; y: 350px; width: parent.width - 40px; text: root.artist; color: Th.card-text2; font-size: 12px; horizontal-alignment: center; overflow: elide; }
                    RoundButton {
                        x: 24px; y: 380px; primary: true;
                        glyph: root.playing || root.loading ? "M 3 3 L 13 3 L 13 13 L 3 13 Z" : "M 4 2 L 14 8 L 4 14 Z";
                        clicked => { if (root.playing || root.loading) { root.stop(); } else { root.play(); } }
                    }
                    // Volume.
                    Rectangle {
                        x: 80px; y: 392px; width: 190px; height: 20px;
                        Rectangle { y: 8px; height: 4px; border-radius: 2px; background: Th.control-stroke; }
                        Rectangle { y: 8px; height: 4px; width: parent.width * root.volume; border-radius: 2px; background: Th.accent; }
                        Rectangle { x: parent.width * root.volume - 9px; y: 1px; width: 18px; height: 18px; border-radius: 9px; background: Th.control;
                            border-width: 1px; border-color: Th.control-stroke;
                            Rectangle { x: 5px; y: 5px; width: 8px; height: 8px; border-radius: 4px; background: Th.accent; } }
                        TouchArea {
                            moved => { if (self.pressed) { root.volume-changed(clamp(self.mouse-x / self.width, 0, 1)); } }
                            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.volume-changed(clamp(self.mouse-x / self.width, 0, 1)); } }
                        }
                    }
                    // Recording.
                    Rectangle {
                        x: 16px; y: 440px; width: parent.width - 32px; height: 52px; border-radius: Th.radius-control;
                        background: Th.control; border-width: 1px; border-color: Th.control-stroke;
                        rec-ta := TouchArea { clicked => { root.toggle-record(); } }
                        Rectangle { x: 14px; y: 18px; width: 16px; height: 16px; border-radius: 8px; border-width: 2px;
                            border-color: root.recording ? #E0573A : Th.control-text.transparentize(45%); background: root.recording ? #E0573A : transparent; }
                        Text { x: 42px; y: 9px; text: root.recording ? "Recording" : (root.record-armed ? "Recording armed" : "Not Recording");
                            color: Th.control-text; font-size: 13px; font-weight: 600; }
                        Text { x: 42px; y: 28px; width: parent.width - 54px; overflow: elide; color: Th.control-text.transparentize(25%); font-size: 11px;
                            text: root.record-armed ? "Every song is saved as its own file." : "Click to save every song as its own file."; }
                    }
                    // Played songs.
                    Text { x: 18px; y: 508px; text: "Played Tracks"; color: Th.card-text2; font-size: 12px; font-weight: 600; }
                    Flickable {
                        x: 12px; y: 530px; width: parent.width - 24px; height: max(0px, parent.height - 540px);
                        content-height: root.tracks.length * 40px;
                        for t[i] in root.tracks: Rectangle {
                            y: i * 40px; height: 38px; border-radius: Th.radius-control; background: Th.subtle;
                            Text { x: 10px; y: 4px; width: parent.width - 20px; text: t.title; color: Th.card-text; font-size: 12px; overflow: elide; }
                            Text { x: 10px; y: 21px; width: parent.width - 20px; text: t.note; color: Th.card-text2; font-size: 11px; overflow: elide; }
                        }
                    }
                }
            }
        }
    }

    // ─────────── Over everything ───────────
    if Scenery.on && Scenery.front-on: Image { x: 0; y: 0; width: root.width; height: root.height; source: Scenery.front; image-fit: fill; }
    if Scenery.band-on: Rectangle {
        x: 0; y: Scenery.band-y; width: root.width; height: 140px;
        background: @linear-gradient(180deg, #FFFFFF00 0%, #FFFFFF09 50%, #FFFFFF00 100%);
    }
    // The spotlight: the dark closes in everywhere but round the pointer.
    if Scenery.spot-on: Rectangle {
        property <length> r: Scenery.spot-radius;
        property <color> dark: #000000.transparentize(1 - Scenery.spot-opacity);
        Rectangle {
            x: Scenery.spot-x - parent.r; y: Scenery.spot-y - parent.r; width: parent.r * 2; height: parent.r * 2;
            background: @radial-gradient(circle, #00000000 0%, #000000.transparentize(1 - Scenery.spot-opacity * 0.45) 60%, parent.dark 100%);
        }
        Rectangle { x: 0; y: 0; width: root.width; height: max(0px, Scenery.spot-y - parent.r); background: parent.dark; }
        Rectangle { x: 0; y: Scenery.spot-y + parent.r; width: root.width; height: max(0px, root.height - Scenery.spot-y - parent.r); background: parent.dark; }
        Rectangle { x: 0; y: Scenery.spot-y - parent.r; width: max(0px, Scenery.spot-x - parent.r); height: parent.r * 2; background: parent.dark; }
        Rectangle { x: Scenery.spot-x + parent.r; y: Scenery.spot-y - parent.r; width: max(0px, root.width - Scenery.spot-x - parent.r); height: parent.r * 2; background: parent.dark; }
    }
    if Th.frame-on: Rectangle { x: 0; y: 0; width: root.width; height: root.height; border-width: Th.frame-thickness; border-color: Th.frame-color; }

    // A message (import results and the like), dismissed with its button.
    if Dir.message != "": Rectangle {
        x: root.pane-w + 24px; y: root.height - 60px; width: min(560px, root.width - root.pane-w - 48px); height: 44px;
        border-radius: Th.radius-card; background: Th.dialog; border-width: 1px; border-color: Th.accent;
        Text { x: 14px; y: (parent.height - self.height) / 2; width: parent.width - 56px; text: Dir.message; color: Th.card-text; font-size: 13px; overflow: elide; }
        Caption { x: parent.width - 42px; y: 6px; width: 36px; height: 32px; glyph: "close"; clicked => { Dir.dismiss(); } }
    }

    // A station's details.
    if Dir.details-open: Rectangle {
        background: #00000099;
        TouchArea { clicked => { Dir.details-close(); } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 560px; height: 420px;
            border-radius: Th.radius-card; background: Th.dialog; border-width: 1px; border-color: Th.card-stroke;
            TouchArea { }
            Cover { x: 24px; y: 24px; width: 132px; height: 132px; source: Dir.details.cover; has-source: Dir.details.has-cover;
                small: Dir.details.small; c1: Dir.details.c1; c2: Dir.details.c2; }
            Text { x: 172px; y: 28px; width: parent.width - 196px; text: Dir.details.name; color: Th.card-text; font-size: 20px; font-weight: 600; wrap: word-wrap; max-height: 56px; overflow: elide; }
            Text { x: 172px; y: 88px; width: parent.width - 196px; text: Dir.details.subtitle; color: Th.card-text2; font-size: 13px; overflow: elide; }
            if Dir.details.local || Dir.details.orphaned: Rectangle {
                x: 172px; y: 114px; height: 22px; width: tag-text.preferred-width + 16px; border-radius: 11px; background: Th.subtle;
                tag-text := Text { x: 8px; y: (parent.height - self.height) / 2; color: Th.card-text2; font-size: 11px;
                    text: Dir.details.local ? "Local station" : "No longer in the directory"; }
            }
            VerticalLayout {
                x: 24px; y: 176px; width: parent.width - 48px; spacing: 2px; alignment: start;
                InfoRow { label: "Tags"; value: Dir.details.tags; }
                InfoRow { label: "Location"; value: Dir.details.location; }
                InfoRow { label: "Language"; value: Dir.details.language; }
                InfoRow { label: "Audio"; value: Dir.details.codec; }
                InfoRow { label: "Votes"; value: Dir.details.votes; }
                InfoRow { label: "Homepage"; value: Dir.details.homepage; }
                InfoRow { label: "Stream"; value: Dir.details.stream; }
            }
            HorizontalLayout {
                x: 24px; y: parent.height - 56px; height: 32px; width: parent.width - 48px; spacing: 8px; alignment: start;
                Btn { text: Dir.details.playing ? "Stop" : "Play"; primary: true; clicked => { Dir.details-play(); } }
                Btn { text: Dir.details.in-library ? "Remove from Library" : "Add to Library"; clicked => { Dir.details-library(); } }
                if Dir.details.homepage != "": Btn { text: "Homepage"; clicked => { Dir.details-homepage(); } }
                Rectangle { }
                Btn { text: "Close"; clicked => { Dir.details-close(); } }
            }
        }
    }

    // Adding a station of your own.
    if Dir.add-open: Rectangle {
        background: #00000099;
        TouchArea { clicked => { Dir.add-open = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 480px; height: 300px;
            border-radius: Th.radius-card; background: Th.dialog; border-width: 1px; border-color: Th.card-stroke;
            TouchArea { }
            Text { x: 24px; y: 22px; text: "Add Local Station"; color: Th.card-text; font-size: 20px; font-weight: 600; }
            Text { x: 24px; y: 60px; width: parent.width - 48px; wrap: word-wrap; color: Th.card-text2; font-size: 12px;
                text: "Any stream address works, and .pls and .m3u playlist links are followed."; }
            add-name := Field { x: 24px; y: 96px; width: parent.width - 48px; placeholder: "Name"; }
            add-url := Field { x: 24px; y: 138px; width: parent.width - 48px; placeholder: "Stream address (https://…)"; }
            Btn { x: 24px; y: 180px; text: Dir.add-cover == "" ? "Choose Cover…" : "Cover: " + Dir.add-cover; clicked => { Dir.choose-cover(); } }
            if Dir.add-error != "": Text { x: 24px; y: 222px; width: parent.width - 48px; text: Dir.add-error; color: #E0573A; font-size: 12px; }
            HorizontalLayout {
                x: 24px; y: parent.height - 52px; height: 32px; width: parent.width - 48px; spacing: 8px; alignment: end;
                Btn { text: "Cancel"; clicked => { Dir.add-open = false; } }
                Btn { text: "Add Station"; primary: true; clicked => { Dir.add-local(add-name.text, add-url.text); } }
            }
        }
    }

    // Resize borders (the window has no system frame).
    if !root.maximized: TouchArea { x: parent.width - 6px; y: root.title-h; width: 6px; height: parent.height - root.title-h - 12px; mouse-cursor: ew-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-edge("e"); } } }
    if !root.maximized: TouchArea { x: 0; y: root.title-h; width: 6px; height: parent.height - root.title-h - 12px; mouse-cursor: ew-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-edge("w"); } } }
    if !root.maximized: TouchArea { x: 12px; y: parent.height - 6px; width: parent.width - 24px; height: 6px; mouse-cursor: ns-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-edge("s"); } } }
    if !root.maximized: TouchArea { x: parent.width - 12px; y: parent.height - 12px; width: 12px; height: 12px; mouse-cursor: nwse-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-edge("se"); } } }
}

// Driftwave's Classic layout: an homage to the stacked player windows of the late 90s, drawn as polished hardware.
// Original vector drawing throughout (no skin bitmaps), coloured from whatever theme is chosen (palette.rs).
//
// Units: everything sits on the classic 275-unit-wide grid. `u` is the window's width / 275, so dragging the corner
// scales the whole player crisply; the window's height beyond the player and visualizer goes to the station list.
// Light comes from the top left: highlights on top and left edges, shadows under and to the right.

export global Pal {
    in-out property <color> face: #2A2D38;
    in-out property <color> bevel-light: #5A5E6E;
    in-out property <color> bevel-dark: #0E0F14;
    in-out property <color> title-a: #3B6EA8;
    in-out property <color> title-b: #24324A;
    in-out property <color> title-text: #FFFFFF;
    in-out property <color> lcd-back: #05070A;
    in-out property <color> lcd-lit: #4CC2FF;
    in-out property <color> lcd-ghost: #4CC2FF1A;
    in-out property <color> button: #343846;
    in-out property <color> glyph: #E8EAF0;
    in-out property <color> glyph-on: #4CC2FF;
    in-out property <color> groove: #15161C;
    in-out property <color> fill-low: #2E7DFF;
    in-out property <color> fill-high: #9FE3FF;
    in-out property <color> list-back: #14151B;
    in-out property <color> list-text: #DDE1EA;
    in-out property <color> list-playing: #4CC2FF;
    in-out property <color> list-selected-back: #2D5F9A;
    in-out property <color> list-selected-text: #FFFFFF;
    in-out property <color> glow: #00000000;
    in-out property <string> body-font: "Segoe UI";
    in-out property <string> lcd-font: "Consolas";
    // Small LCD labels: the LCD font, unless it's a pixel face that only reads when large.
    in-out property <string> lcd-small-font: "Consolas";
    // The theme's picture as the skin under the panels' faces (see-through then), what lies over everything
    // (grain, scanlines), and the theme's neon on the panels' edges.
    in-out property <bool> skin-on;
    in-out property <image> skin;
    in-out property <bool> skin-front-on;
    in-out property <image> skin-front;
    in-out property <bool> edge-on;
    in-out property <color> edge: #FF3D88;
}

export struct StationRow {
    name: string,
    detail: string,
    playing: bool,
}

export struct Choice {
    id: string,
    name: string,
    on: bool,
}

// A panel of the player: brushed face, a dark outer line and a light inner one.
component Frame inherits Rectangle {
    // Over the theme's picture, the face is tinted glass.
    property <float> see: Pal.skin-on ? 0.4 : 0;
    background: @linear-gradient(180deg, Pal.face.brighter(9%).transparentize(self.see) 0%, Pal.face.transparentize(self.see) 38%,
        Pal.face.darker(10%).transparentize(self.see * 0.8) 100%);
    border-width: 1px;
    border-color: Pal.edge-on ? Pal.edge : Pal.bevel-dark.darker(25%);
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-width: 1px; background: transparent;
        border-color: Pal.edge-on ? Pal.edge.mix(#FFFFFF, 0.45).transparentize(0.35) : Pal.bevel-light.transparentize(62%);
    }
    @children
}

// A recessed well (the LCD, gauges, the list): shadow inside the top edge, light along the bottom lip.
component Well inherits Rectangle {
    in property <color> fill: Pal.lcd-back;
    in property <length> shade: 5px;
    background: fill;
    border-radius: 2px;
    border-width: 1px;
    border-color: Pal.bevel-dark.darker(30%);
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: min(root.shade, parent.height / 2); border-radius: 1px;
        background: @linear-gradient(180deg, #00000070 0%, #00000000 100%);
    }
    Rectangle { x: 2px; y: parent.height; width: parent.width - 4px; height: 1px; background: Pal.bevel-light.transparentize(55%); }
    @children
}

// One seven-segment digit; lit segments glow softly, unlit ones stay faintly visible, like real LCD glass.
component Digit inherits Rectangle {
    in property <int> value;
    in property <bool> dim;
    property <length> t: self.width * 0.17;
    property <length> halo: t * 0.45;
    property <color> on: dim ? Pal.lcd-lit.transparentize(50%) : Pal.lcd-lit;
    property <color> off: Pal.lcd-ghost;
    property <color> glow: dim ? transparent : Pal.lcd-lit.transparentize(80%);
    property <bool> a: value == 0 || value == 2 || value == 3 || value == 5 || value == 6 || value == 7 || value == 8 || value == 9;
    property <bool> b: value == 0 || value == 1 || value == 2 || value == 3 || value == 4 || value == 7 || value == 8 || value == 9;
    property <bool> c: value == 0 || value == 1 || value == 3 || value == 4 || value == 5 || value == 6 || value == 7 || value == 8 || value == 9;
    property <bool> d: value == 0 || value == 2 || value == 3 || value == 5 || value == 6 || value == 8 || value == 9;
    property <bool> e: value == 0 || value == 2 || value == 6 || value == 8;
    property <bool> f: value == 0 || value == 4 || value == 5 || value == 6 || value == 8 || value == 9;
    property <bool> g: value == 2 || value == 3 || value == 4 || value == 5 || value == 6 || value == 8 || value == 9;
    property <length> half: self.height / 2;
    // Glow behind the lit segments.
    if a: Rectangle { x: t - halo; y: -halo; width: parent.width - 2 * t + 2 * halo; height: t + 2 * halo; border-radius: t; background: glow; }
    if b: Rectangle { x: parent.width - t - halo; y: t * 0.6 - halo; width: t + 2 * halo; height: half - t * 0.9 + 2 * halo; border-radius: t; background: glow; }
    if c: Rectangle { x: parent.width - t - halo; y: half + t * 0.3 - halo; width: t + 2 * halo; height: half - t * 0.9 + 2 * halo; border-radius: t; background: glow; }
    if d: Rectangle { x: t - halo; y: parent.height - t - halo; width: parent.width - 2 * t + 2 * halo; height: t + 2 * halo; border-radius: t; background: glow; }
    if e: Rectangle { x: -halo; y: half + t * 0.3 - halo; width: t + 2 * halo; height: half - t * 0.9 + 2 * halo; border-radius: t; background: glow; }
    if f: Rectangle { x: -halo; y: t * 0.6 - halo; width: t + 2 * halo; height: half - t * 0.9 + 2 * halo; border-radius: t; background: glow; }
    if g: Rectangle { x: t - halo; y: half - t / 2 - halo; width: parent.width - 2 * t + 2 * halo; height: t + 2 * halo; border-radius: t; background: glow; }
    Rectangle { x: t; y: 0; width: parent.width - 2 * t; height: t; border-radius: t / 2; background: a ? on : off; }
    Rectangle { x: parent.width - t; y: t * 0.6; width: t; height: half - t * 0.9; border-radius: t / 2; background: b ? on : off; }
    Rectangle { x: parent.width - t; y: half + t * 0.3; width: t; height: half - t * 0.9; border-radius: t / 2; background: c ? on : off; }
    Rectangle { x: t; y: parent.height - t; width: parent.width - 2 * t; height: t; border-radius: t / 2; background: d ? on : off; }
    Rectangle { x: 0; y: half + t * 0.3; width: t; height: half - t * 0.9; border-radius: t / 2; background: e ? on : off; }
    Rectangle { x: 0; y: t * 0.6; width: t; height: half - t * 0.9; border-radius: t / 2; background: f ? on : off; }
    Rectangle { x: t; y: half - t / 2; width: parent.width - 2 * t; height: t; border-radius: t / 2; background: g ? on : off; }
}

// A small LED: lit with a soft halo, or dark glass.
component Led inherits Rectangle {
    in property <bool> lit;
    in property <color> tint: Pal.glyph-on;
    border-radius: self.height / 2;
    background: lit ? @linear-gradient(180deg, tint.brighter(35%) 0%, tint 60%, tint.darker(15%) 100%) : Pal.lcd-back.brighter(25%);
    border-width: 1px;
    border-color: lit ? tint.darker(30%) : Pal.bevel-dark;
    if lit: Rectangle {
        x: -parent.height * 0.6; y: -parent.height * 0.6; width: parent.width + parent.height * 1.2; height: parent.height * 2.2;
        border-radius: self.height / 2; background: tint.transparentize(82%);
    }
}

// A raised button with a gloss highlight; it sinks when pressed or switched on.
component Button3D inherits Rectangle {
    in property <bool> on;
    in property <length> radius: 2px;
    callback clicked();
    out property <bool> down: ta.pressed || on;
    out property <bool> hover: ta.has-hover;
    border-radius: radius;
    border-width: 1px;
    border-color: Pal.bevel-dark.darker(30%);
    background: down
        ? @linear-gradient(180deg, Pal.button.darker(32%) 0%, Pal.button.darker(12%) 100%)
        : @linear-gradient(180deg, Pal.button.brighter(hover ? 34% : 22%) 0%, Pal.button.brighter(hover ? 8% : 0%) 52%, Pal.button.darker(14%) 100%);
    // Gloss on the top edge, shadow on the bottom edge.
    if !down: Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 1px; background: #FFFFFF38; }
    if !down: Rectangle { x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 1px; background: #0000002E; }
    if down: Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 2px; background: #00000040; }
    ta := TouchArea { clicked => { root.clicked(); } }
    @children
}

// A vector glyph with an engraved shadow, pressed down a touch when its button is.
component Glyph inherits Rectangle {
    in property <string> commands;
    in property <color> ink: Pal.glyph;
    in property <bool> down;
    in property <length> view-w: 20px;
    in property <length> view-h: 16px;
    Path {
        x: 1px; y: (down ? 1px : 0px) + 1px; width: parent.width; height: parent.height;
        viewbox-width: root.view-w / 1px; viewbox-height: root.view-h / 1px; fill: #00000066; stroke: transparent; commands: root.commands;
    }
    Path {
        x: 0; y: down ? 1px : 0px; width: parent.width; height: parent.height;
        viewbox-width: root.view-w / 1px; viewbox-height: root.view-h / 1px; fill: root.ink; stroke: transparent; commands: root.commands;
    }
}

// Embossed text: a dark copy a pixel down, the text on top.
component Emboss inherits Rectangle {
    in property <string> text;
    in property <color> ink: Pal.glyph;
    in property <length> size;
    in property <string> family: Pal.body-font;
    in property <int> weight: 700;
    in property <length> spacing;
    // The embossed shadow only where it's big enough to read as relief (small, it smears the letters).
    in property <bool> relief: root.size >= 10px;
    width: tx.preferred-width; height: tx.preferred-height;
    if root.relief: Text { x: 0; y: 1px; text: root.text; color: #00000080; font-size: root.size; font-family: root.family; font-weight: root.weight; letter-spacing: root.spacing; }
    tx := Text { x: 0; y: 0; text: root.text; color: root.ink; font-size: root.size; font-family: root.family; font-weight: root.weight; letter-spacing: root.spacing; }
}

// A title bar: a glossy gradient with engraved ridges either side of the title; drag anywhere on it.
component TitleBar inherits Rectangle {
    in property <length> u;
    in property <string> title;
    in property <bool> active: true;
    callback drag();
    border-radius: 1px;
    background: @linear-gradient(90deg, Pal.title-a 0%, Pal.title-b 100%);
    opacity: active ? 1 : 0.78;
    Rectangle { y: 0; height: parent.height / 2; background: @linear-gradient(180deg, #FFFFFF2A 0%, #FFFFFF08 100%); }
    Rectangle { y: parent.height - 1px; height: 1px; background: #00000055; }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.drag(); }
        }
    }
    property <length> mid: self.width / 2;
    property <length> gap: tt.width / 2 + 5 * u;
    for k in 3: Rectangle {
        x: 20 * u; y: (2.5 + k * 2.4) * u; width: max(0px, root.mid - root.gap - 20 * u); height: 1px;
        background: #00000045;
        Rectangle { y: 1px; height: 1px; background: #FFFFFF22; }
    }
    for k in 3: Rectangle {
        x: root.mid + root.gap; y: (2.5 + k * 2.4) * u; width: max(0px, root.mid - root.gap - 31 * u); height: 1px;
        background: #00000045;
        Rectangle { y: 1px; height: 1px; background: #FFFFFF22; }
    }
    tt := Emboss {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        text: root.title; ink: Pal.title-text; size: max(9px, 6 * u); family: Pal.body-font; spacing: 1.2 * u;
    }
    @children
}

// A small title-bar button.
component TitleButton inherits Button3D {
    in property <length> u;
    in property <string> glyph; // min, shade, close, menu, left, right
    width: 8 * u; height: 8 * u; radius: 1.5px;
    Glyph {
        x: 2 * u; y: 2 * u; width: 4 * u; height: 4 * u; down: root.down; view-w: 10px; view-h: 10px; ink: Pal.glyph;
        commands: glyph == "min" ? "M 1 7 L 9 7 L 9 9 L 1 9 Z"
            : glyph == "shade" ? "M 1 1 L 9 1 L 9 3 L 1 3 Z M 1 5 L 9 5 L 9 6 L 1 6 Z"
            : glyph == "close" ? "M 1 2.4 L 2.4 1 L 5 3.6 L 7.6 1 L 9 2.4 L 6.4 5 L 9 7.6 L 7.6 9 L 5 6.4 L 2.4 9 L 1 7.6 L 3.6 5 Z"
            : glyph == "left" ? "M 7 1 L 7 9 L 2 5 Z"
            : glyph == "right" ? "M 3 1 L 8 5 L 3 9 Z"
            : "M 1 1.5 L 9 1.5 L 9 3 L 1 3 Z M 1 4.3 L 9 4.3 L 9 5.8 L 1 5.8 Z M 1 7 L 9 7 L 9 8.5 L 1 8.5 Z";
    }
}

// A transport button: the glyph engraved into a glossy key.
component Transport inherits Button3D {
    in property <length> u;
    in property <string> glyph; // prev play pause stop next eject
    property <color> ink: root.on ? Pal.glyph-on : Pal.glyph;
    Glyph {
        x: (parent.width - 9 * u) / 2; y: (parent.height - 7.2 * u) / 2; width: 9 * u; height: 7.2 * u; down: root.down; ink: root.ink;
        commands: glyph == "play" ? "M 5 0 L 17 8 L 5 16 Z"
            : glyph == "pause" ? "M 4 0 L 8.5 0 L 8.5 16 L 4 16 Z M 11.5 0 L 16 0 L 16 16 L 11.5 16 Z"
            : glyph == "stop" ? "M 4 1.5 L 16 1.5 L 16 14.5 L 4 14.5 Z"
            : glyph == "prev" ? "M 2 0 L 5 0 L 5 16 L 2 16 Z M 18 0 L 18 16 L 6 8 Z"
            : glyph == "next" ? "M 2 0 L 14 8 L 2 16 Z M 15 0 L 18 0 L 18 16 L 15 16 Z"
            : "M 10 1 L 18 9 L 2 9 Z M 2 11.5 L 18 11.5 L 18 15 L 2 15 Z";
    }
}

// A labelled toggle pill with its own LED.
component Pill inherits Button3D {
    in property <length> u;
    in property <string> label;
    radius: self.height / 2;
    Led { x: 3.5 * u; y: (parent.height - 3 * u) / 2; width: 3 * u; height: 3 * u; lit: root.on; }
    Text {
        x: 8 * u; y: (parent.height - self.height) / 2 + (root.down ? 1px : 0px); text: root.label;
        font-size: max(7.5px, 4.6 * u); font-weight: 800; letter-spacing: 0.3 * u; color: root.on ? Pal.glyph-on : Pal.glyph.transparentize(15%);
    }
}

// The clutter strip's letters.
component Letter inherits Rectangle {
    in property <length> u;
    in property <string> letter;
    in property <bool> on;
    callback clicked();
    width: 7 * u; height: 8 * u;
    border-radius: 1px;
    background: ta.pressed ? #00000040 : (ta.has-hover ? #FFFFFF14 : transparent);
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: letter; font-family: Pal.lcd-font; font-size: max(8.5px, 5.6 * u); font-weight: 700;
        color: on ? Pal.lcd-lit : Pal.lcd-lit.transparentize(ta.has-hover ? 35% : 72%);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

// A horizontal slider: a recessed groove, a glossy fill, and a raised knob with grip lines.
component Slider inherits Rectangle {
    in property <length> u;
    in-out property <float> value; // 0..1
    callback changed(float);
    property <length> knob: 10 * u;
    Well { x: 0; y: (parent.height - 3.4 * u) / 2; width: parent.width; height: 3.4 * u; fill: Pal.groove; shade: 2px; border-radius: 1.7 * u; }
    Rectangle {
        x: 1px; y: (parent.height - 3.4 * u) / 2 + 1px; height: 3.4 * u - 2px; border-radius: 1.7 * u;
        width: max(0px, (parent.width - 2px) * root.value);
        background: @linear-gradient(90deg, Pal.fill-low 0%, Pal.fill-high 100%);
        Rectangle { y: 0; height: parent.height / 2; border-radius: parent.border-radius; background: #FFFFFF30; }
    }
    Button3D {
        width: root.knob; height: parent.height; x: (parent.width - root.knob) * root.value; radius: 1.5 * u;
        for k in 3: Rectangle { x: (3 + k * 1.6) * u; y: 2.4 * u; width: 1px; height: parent.height - 4.8 * u; background: #00000050;
            Rectangle { x: 1px; width: 1px; background: #FFFFFF26; } }
    }
    TouchArea {
        moved => { if (self.pressed) { root.changed(clamp((self.mouse-x - root.knob / 2) / (root.width - root.knob), 0, 1)); } }
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.changed(clamp((self.mouse-x - root.knob / 2) / (root.width - root.knob), 0, 1)); } }
    }
}

// The Driftwave sun over drifting waves.
component Logo inherits Rectangle {
    in property <length> u;
    Rectangle {
        x: 4 * u; y: 0; width: 13 * u; height: 13 * u; border-radius: 6.5 * u; clip: true;
        background: @linear-gradient(180deg, #FFD36E 0%, #FF8A70 55%, #FF6FA8 100%);
        Rectangle { y: 0; height: parent.height * 0.4; background: #FFFFFF30; }
        for k in 3: Rectangle { x: 0; y: (7 + k * 2.1) * u; width: parent.width; height: 0.9 * u; background: Pal.face.darker(5%); }
    }
    Path {
        x: 0; y: 12 * u; width: 21 * u; height: 5 * u; viewbox-width: 28; viewbox-height: 8;
        commands: "M 0 4 Q 3.5 0 7 4 T 14 4 T 21 4 T 28 4"; stroke: Pal.glyph-on; stroke-width: 0.9 * u; fill: transparent;
    }
}

// The Classic layout, as a view inside the app's one window (app.slint swaps it with the Full layout).
export component ClassicView inherits Rectangle {
    background: Pal.face.darker(20%);

    // One unit: the window is 275 of them wide.
    out property <length> u: self.width / 275;
    in-out property <bool> shaded;
    in-out property <bool> show-vis: true;
    in-out property <bool> show-list: true;
    in-out property <bool> on-top;
    in-out property <bool> active: true;

    // Now playing.
    in property <string> station: "Driftwave";
    in property <string> marquee: "DRIFTWAVE  ***  CHOOSE A STATION BELOW";
    in-out property <length> marquee-offset;
    out property <length> marquee-width: mq.width;
    in property <int> minutes;
    in property <int> seconds;
    in property <bool> clock-mode;
    in property <int> kbps;
    in property <int> khz;
    in property <bool> stereo;
    in property <bool> mono;
    in property <bool> playing;
    in property <bool> loading;
    in property <float> buffer; // 0..1
    in property <string> status: "STOPPED";
    in-out property <float> volume: 0.8;
    in property <bool> recording;
    in property <bool> record-armed;

    // Visualizers.
    in property <image> vis-mini;
    in property <image> vis-big;
    in property <string> vis-name: "Peak Meter";
    out property <length> mini-width: 80 * u;
    out property <length> mini-height: 15 * u;
    out property <length> big-width: 263 * u;
    out property <length> big-height: 83 * u;

    // The station list.
    in property <[StationRow]> stations;
    in-out property <int> selected: -1;
    in property <string> list-summary;

    // Options.
    in property <[Choice]> themes;
    in property <string> layout-name: "Classic";
    in property <string> version;

    // Heights, for the app to size the window: the player and visualizer are fixed; the list takes the rest.
    out property <length> main-h: shaded ? 13 * u : 102 * u;
    out property <length> vis-h: show-vis ? 104 * u : 0;
    out property <length> fixed-h: main-h + vis-h;
    out property <length> min-list-h: 62 * u;
    property <length> list-h: show-list ? max(0px, root.height - fixed-h) : 0;
    property <length> list-row: 8.5 * u;

    callback drag();
    callback resize();
    // Where the OS can't resize from the corner (winit on macOS): the grip resizes by the mouse's travel.
    in property <bool> manual-resize;
    callback resize-by(length, length);
    callback minimize();
    callback quit();
    callback play();
    callback pause();
    callback stop();
    callback prev();
    callback next();
    callback toggle-record();
    callback toggle-clock();
    callback volume-changed(float);
    callback play-station(int);
    callback next-vis();
    callback prev-vis();
    callback toggle-on-top();
    callback choose-theme(string);
    callback toggle-double();
    callback panels-changed();
    callback to-full();

    // The theme's picture, under everything.
    if Pal.skin-on: Image { x: 0; y: 0; width: root.width; height: root.height; source: Pal.skin; image-fit: fill; }

    // ───────────────────────── The player ─────────────────────────
    Frame {
        x: 0; y: 0; width: root.width; height: main-h;
        TitleBar {
            x: 2 * u; y: 2 * u; width: parent.width - 4 * u; height: 10 * u; u: u; active: root.active;
            title: shaded ? "" : "DRIFTWAVE";
            drag => { root.drag(); }
            TitleButton { x: 1 * u; y: 1 * u; u: u; glyph: "menu"; clicked => { options.show(); } }
            TitleButton { x: parent.width - 28 * u; y: 1 * u; u: u; glyph: "min"; clicked => { root.minimize(); } }
            TitleButton { x: parent.width - 19 * u; y: 1 * u; u: u; glyph: "shade"; clicked => { root.shaded = !root.shaded; root.panels-changed(); } }
            TitleButton { x: parent.width - 10 * u; y: 1 * u; u: u; glyph: "close"; clicked => { root.quit(); } }
            if shaded: Text {
                x: 12 * u; y: (parent.height - self.height) / 2; text: root.marquee; color: Pal.title-text; font-family: Pal.lcd-font; font-size: max(8.5px, 5.6 * u);
                width: parent.width - 76 * u; overflow: elide;
            }
            if shaded: Text {
                x: parent.width - 56 * u; y: (parent.height - self.height) / 2; color: Pal.title-text; font-family: Pal.lcd-font; font-size: max(8.5px, 5.6 * u); font-weight: 700;
                text: (root.minutes < 10 ? "0" : "") + root.minutes + ":" + (root.seconds < 10 ? "0" : "") + root.seconds;
            }
        }
        if !shaded: Well {
            // The clutter strip: Options, Always on top, the station list, Double size, the Visualizer.
            x: 3 * u; y: 16 * u; width: 7 * u; height: 46 * u; fill: Pal.lcd-back;
            VerticalLayout {
                padding-top: 2 * u; spacing: 0.5 * u;
                Letter { u: u; letter: "O"; clicked => { options.show(); } }
                Letter { u: u; letter: "A"; on: root.on-top; clicked => { root.toggle-on-top(); } }
                Letter { u: u; letter: "I"; on: root.show-list; clicked => { root.show-list = !root.show-list; root.panels-changed(); } }
                Letter { u: u; letter: "D"; on: root.u > 1.75px; clicked => { root.toggle-double(); } }
                Letter { u: u; letter: "V"; on: root.show-vis; clicked => { root.show-vis = !root.show-vis; root.panels-changed(); } }
            }
        }
        if !shaded: Well {
            // The LCD: state, time, and the mini spectrum.
            x: 12 * u; y: 16 * u; width: 86 * u; height: 46 * u; fill: Pal.lcd-back;
            Glyph {
                x: 4 * u; y: 4.5 * u; width: 5 * u; height: 6 * u; view-w: 12px; view-h: 14px;
                ink: root.playing ? Pal.lcd-lit : Pal.lcd-lit.transparentize(55%);
                commands: root.playing ? "M 1 0 L 12 7 L 1 14 Z" : (root.loading ? "M 0 0 L 4 0 L 4 14 L 0 14 Z M 7 0 L 11 0 L 11 14 L 7 14 Z" : "M 0 1 L 12 1 L 12 13 L 0 13 Z");
            }
            // Recording: a steady lamp, never blinking.
            Led { x: 4 * u; y: 14 * u; width: 5.5 * u; height: 2.6 * u; lit: root.recording; tint: #FF7A4F; }
            Digit { x: 20 * u; y: 4 * u; width: 9 * u; height: 15 * u; value: root.minutes / 10; dim: !root.playing; }
            Digit { x: 31 * u; y: 4 * u; width: 9 * u; height: 15 * u; value: mod(root.minutes, 10); dim: !root.playing; }
            Rectangle { x: 42.3 * u; y: 7.5 * u; width: 1.7 * u; height: 1.7 * u; border-radius: 0.85 * u; background: root.playing ? Pal.lcd-lit : Pal.lcd-lit.transparentize(55%); }
            Rectangle { x: 42.3 * u; y: 13 * u; width: 1.7 * u; height: 1.7 * u; border-radius: 0.85 * u; background: root.playing ? Pal.lcd-lit : Pal.lcd-lit.transparentize(55%); }
            Digit { x: 46.5 * u; y: 4 * u; width: 9 * u; height: 15 * u; value: root.seconds / 10; dim: !root.playing; }
            Digit { x: 57.5 * u; y: 4 * u; width: 9 * u; height: 15 * u; value: mod(root.seconds, 10); dim: !root.playing; }
            Text { x: 69 * u; y: 4 * u; text: root.clock-mode ? "CLK" : "ELAP"; color: Pal.lcd-lit.transparentize(45%); font-size: max(7.5px, 4.6 * u); font-family: Pal.lcd-small-font; font-weight: 700; }
            TouchArea { x: 18 * u; y: 2 * u; width: 52 * u; height: 19 * u; clicked => { root.toggle-clock(); } }
            // Glass: a reflection across the digits only (never over the moving spectrum, so it costs nothing per frame).
            Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 11 * u; border-radius: 1px;
                background: @linear-gradient(180deg, #FFFFFF12 0%, #FFFFFF04 100%); }
            // The mini spectrum: click for the next visualizer.
            Rectangle {
                x: 3 * u; y: 27.5 * u; width: 80 * u; height: 15 * u; clip: true; background: #000000; border-radius: 1px;
                Image { width: parent.width; height: parent.height; source: root.vis-mini; image-rendering: smooth; image-fit: fill; }
                TouchArea { clicked => { root.next-vis(); } }
            }
        }
        // The marquee: the song, scrolling smoothly. (Hidden, not removed, when shaded, so its width is known.)
        Well {
            visible: !shaded;
            x: 101 * u; y: 16 * u; width: 171 * u; height: 13 * u; fill: Pal.lcd-back; clip: true;
            mq := Text {
                x: 3 * u - root.marquee-offset; y: (parent.height - self.height) / 2;
                text: root.marquee; color: Pal.lcd-lit; font-family: Pal.lcd-font; font-size: max(9.5px, 6.6 * u);
            }
            Text { x: mq.x + mq.width + 24 * u; y: mq.y; text: root.marquee; color: Pal.lcd-lit; font-family: Pal.lcd-font; font-size: max(9.5px, 6.6 * u); }
        }
        if !shaded: Rectangle {
            // Bitrate, sample rate, and mono / stereo LEDs. Blank ("--") until the stream says.
            x: 101 * u; y: 32 * u; width: 171 * u; height: 9 * u;
            Well { x: 0; width: 18 * u; height: parent.height; fill: Pal.lcd-back; shade: 3px;
                Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: root.kbps > 0 ? root.kbps : "--"; color: Pal.lcd-lit; font-family: Pal.lcd-small-font; font-size: max(8.5px, 5.6 * u); font-weight: 700; } }
            Text { x: 20 * u; y: (parent.height - self.height) / 2; text: "kbps"; color: Pal.glyph.transparentize(35%); font-size: max(8.5px, 5.2 * u); }
            Well { x: 37 * u; width: 14 * u; height: parent.height; fill: Pal.lcd-back; shade: 3px;
                Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: root.khz > 0 ? root.khz : "--"; color: Pal.lcd-lit; font-family: Pal.lcd-small-font; font-size: max(8.5px, 5.6 * u); font-weight: 700; } }
            Text { x: 53 * u; y: (parent.height - self.height) / 2; text: "kHz"; color: Pal.glyph.transparentize(35%); font-size: max(8.5px, 5.2 * u); }
            Led { x: 104 * u; y: 3 * u; width: 5 * u; height: 3 * u; lit: root.playing && root.mono; }
            Text { x: 111 * u; y: (parent.height - self.height) / 2; text: "MONO"; font-size: max(8px, 5 * u); font-weight: 700; color: Pal.glyph.transparentize(root.mono && root.playing ? 0% : 55%); }
            Led { x: 134 * u; y: 3 * u; width: 5 * u; height: 3 * u; lit: root.playing && root.stereo; }
            Text { x: 141 * u; y: (parent.height - self.height) / 2; text: "STEREO"; font-size: max(8px, 5 * u); font-weight: 700; color: Pal.glyph.transparentize(root.stereo && root.playing ? 0% : 55%); }
        }
        if !shaded: Path {
            // A speaker, for the volume.
            x: 101 * u; y: 46 * u; width: 6 * u; height: 6 * u; viewbox-width: 12; viewbox-height: 12; stroke: transparent; fill: Pal.glyph.transparentize(25%);
            commands: "M 0 4 L 3 4 L 7 0 L 7 12 L 3 8 L 0 8 Z M 9 3 Q 11.5 6 9 9 L 8.6 8 Q 10.4 6 8.6 4 Z";
        }
        if !shaded: Slider {
            x: 109 * u; y: 44 * u; width: 84 * u; height: 10 * u; u: u; value: root.volume;
            changed(v) => { root.volume = v; root.volume-changed(v); }
        }
        if !shaded: Text {
            x: 196 * u; y: 46 * u; text: Math.round(root.volume * 100) + "%"; color: Pal.glyph.transparentize(25%);
            font-family: Pal.lcd-font; font-size: max(8.5px, 5.2 * u); font-weight: 700;
        }
        if !shaded: Text {
            x: 214 * u; y: 46 * u; width: 58 * u; horizontal-alignment: right; overflow: elide;
            text: root.status; color: Pal.glyph.transparentize(15%); font-family: Pal.lcd-small-font; font-size: max(8.5px, 5.2 * u); font-weight: 700;
        }
        if !shaded: Rectangle {
            // The buffer gauge: how much of the stream is waiting to play (live radio has nothing to seek).
            x: 12 * u; y: 65 * u; width: 260 * u; height: 6 * u;
            // The groove, a gap, the light, a gap, LIVE: each clear of the next.
            property <length> gauge: self.width - max(27 * u, live.preferred-width + 17 * u);
            Well { width: gauge; height: parent.height; fill: Pal.groove; shade: 2px; border-radius: 3 * u; }
            Rectangle {
                x: 1px; y: 1px; height: parent.height - 2px; width: max(0px, (gauge - 2px) * root.buffer); border-radius: 3 * u;
                background: @linear-gradient(90deg, Pal.fill-low.transparentize(45%) 0%, Pal.fill-low 100%);
                Rectangle { y: 0; height: parent.height / 2; border-radius: parent.border-radius; background: #FFFFFF26; }
            }
            Led { x: gauge + 4 * u; y: 1.5 * u; width: 5 * u; height: 3 * u; lit: root.playing; }
            live := Text { x: gauge + 12.5 * u; y: (parent.height - self.height) / 2; text: "LIVE"; font-size: max(8px, 5 * u); font-weight: 800;
                color: Pal.glyph.transparentize(root.playing ? 0% : 55%); }
        }
        if !shaded: Rectangle {
            // Transport: one segmented strip of keys, then eject, then the toggles.
            x: 12 * u; y: 76 * u; width: 260 * u; height: 20 * u;
            Rectangle {
                x: 0; width: 115 * u; height: parent.height; border-radius: 2px; background: Pal.bevel-dark.darker(30%);
                HorizontalLayout {
                    padding: 1px; spacing: 1px;
                    Transport { u: u; glyph: "prev"; clicked => { root.prev(); } }
                    Transport { u: u; glyph: "play"; on: root.playing; clicked => { root.play(); } }
                    Transport { u: u; glyph: "pause"; clicked => { root.pause(); } }
                    Transport { u: u; glyph: "stop"; clicked => { root.stop(); } }
                    Transport { u: u; glyph: "next"; clicked => { root.next(); } }
                }
            }
            Transport { x: 119 * u; width: 21 * u; height: parent.height; u: u; glyph: "eject"; on: root.show-list; clicked => { root.show-list = !root.show-list; root.panels-changed(); } }
            Pill { x: 146 * u; y: 4 * u; width: 25 * u; height: 12 * u; u: u; label: "REC"; on: root.record-armed; clicked => { root.toggle-record(); } }
            Pill { x: 173 * u; y: 4 * u; width: 25 * u; height: 12 * u; u: u; label: "VIS"; on: root.show-vis; clicked => { root.show-vis = !root.show-vis; root.panels-changed(); } }
            Pill { x: 200 * u; y: 4 * u; width: 25 * u; height: 12 * u; u: u; label: "LIST"; on: root.show-list; clicked => { root.show-list = !root.show-list; root.panels-changed(); } }
            Logo { x: 236 * u; y: 1 * u; width: 22 * u; height: 18 * u; u: u; }
        }
    }

    // ───────────────────────── The visualizer ─────────────────────────
    if show-vis: Frame {
        x: 0; y: main-h; width: root.width; height: vis-h;
        TitleBar {
            x: 2 * u; y: 2 * u; width: parent.width - 4 * u; height: 10 * u; u: u; active: root.active;
            title: "VISUALIZER  ·  " + root.vis-name;
            drag => { root.drag(); }
            TitleButton { x: 1 * u; y: 1 * u; u: u; glyph: "left"; clicked => { root.prev-vis(); } }
            TitleButton { x: 10 * u; y: 1 * u; u: u; glyph: "right"; clicked => { root.next-vis(); } }
            TitleButton { x: parent.width - 10 * u; y: 1 * u; u: u; glyph: "close"; clicked => { root.show-vis = false; root.panels-changed(); } }
        }
        Well {
            x: 5 * u; y: 15 * u; width: 265 * u; height: 85 * u; fill: #000000; shade: 0px;
            Rectangle {
                x: 1 * u; y: 1 * u; width: 263 * u; height: 83 * u; clip: true; background: #000000;
                Image { width: parent.width; height: parent.height; source: root.vis-big; image-rendering: smooth; image-fit: fill; }
                // Neon themes light the slot's edge.
                Rectangle { border-width: 1px; border-color: Pal.glow; }
                TouchArea { clicked => { root.next-vis(); } }
            }
        }
    }

    // ───────────────────────── The station list ─────────────────────────
    if show-list: Frame {
        x: 0; y: fixed-h; width: root.width; height: list-h;
        TitleBar {
            x: 2 * u; y: 2 * u; width: parent.width - 4 * u; height: 10 * u; u: u; active: root.active;
            title: "STATIONS";
            drag => { root.drag(); }
            TitleButton { x: parent.width - 10 * u; y: 1 * u; u: u; glyph: "close"; clicked => { root.show-list = false; root.panels-changed(); } }
        }
        Well {
            x: 5 * u; y: 15 * u; width: 265 * u; height: max(10 * u, parent.height - 33 * u); fill: Pal.list-back; clip: true;
            fl := Flickable {
                x: 1px; y: 1px; width: parent.width - 2px - 4 * u; height: parent.height - 2px;
                content-height: root.stations.length * root.list-row;
                for s[i] in root.stations: Rectangle {
                    y: i * root.list-row; height: root.list-row; width: parent.width;
                    background: i == root.selected ? @linear-gradient(180deg, Pal.list-selected-back.brighter(12%) 0%, Pal.list-selected-back 100%)
                        : (rt.has-hover ? Pal.list-selected-back.transparentize(78%) : (mod(i, 2) == 1 ? #FFFFFF07 : transparent));
                    rt := TouchArea {
                        clicked => { root.selected = i; }
                        double-clicked => { root.selected = i; root.play-station(i); }
                    }
                    if s.playing: Path {
                        x: 2 * u; y: (parent.height - 4 * u) / 2; width: 3 * u; height: 4 * u; viewbox-width: 6; viewbox-height: 8; stroke: transparent;
                        fill: i == root.selected ? Pal.list-selected-text : Pal.list-playing; commands: "M 0 0 L 6 4 L 0 8 Z";
                    }
                    Text {
                        x: 6.5 * u; y: (parent.height - self.height) / 2; width: parent.width - 80 * u; overflow: elide;
                        text: (i + 1) + ". " + s.name; font-size: max(8.5px, 5.2 * u);
                        color: i == root.selected ? Pal.list-selected-text : (s.playing ? Pal.list-playing : Pal.list-text);
                        font-weight: s.playing ? 700 : 400;
                    }
                    Text {
                        x: parent.width - self.width - 3 * u; y: (parent.height - self.height) / 2; width: 70 * u; horizontal-alignment: right; overflow: elide;
                        text: s.detail; font-size: max(8px, 5 * u); font-family: Pal.lcd-small-font;
                        color: i == root.selected ? Pal.list-selected-text : Pal.list-text.transparentize(40%);
                    }
                }
            }
            // A slim scrollbar, only when there's more than fits.
            if fl.content-height > fl.height: Rectangle {
                x: parent.width - 4 * u; y: 1px; width: 3 * u - 1px; height: parent.height - 2px; background: #00000030; border-radius: 1.5 * u;
                Rectangle {
                    x: 0; width: parent.width; border-radius: parent.border-radius;
                    height: max(6 * u, parent.height * fl.height / fl.content-height);
                    y: (parent.height - self.height) * (-fl.content-y / max(1px, fl.content-height - fl.height));
                    background: @linear-gradient(90deg, Pal.button.brighter(30%) 0%, Pal.button 100%);
                }
            }
        }
        Rectangle {
            x: 5 * u; y: parent.height - 16 * u; width: 265 * u; height: 12 * u;
            Transport { x: 0; width: 20 * u; height: parent.height; u: u; glyph: "play"; clicked => { if (root.selected >= 0) { root.play-station(root.selected); } } }
            Well {
                x: 23 * u; width: 110 * u; height: parent.height; fill: Pal.lcd-back; shade: 3px;
                Text { x: 3 * u; y: (parent.height - self.height) / 2; text: root.list-summary; color: Pal.lcd-lit; font-family: Pal.lcd-small-font; font-size: max(8.5px, 5.2 * u); font-weight: 700; }
            }
            Text {
                x: parent.width - self.width - 12 * u; y: (parent.height - self.height) / 2;
                text: root.layout-name + " layout"; color: Pal.glyph.transparentize(50%); font-size: max(8.5px, 5.2 * u);
            }
        }
    }

    // Grain and scanlines over everything.
    if Pal.skin-front-on: Image { x: 0; y: 0; width: root.width; height: root.height; source: Pal.skin-front; image-fit: fill; }

    // The resize grip, in the window's bottom-right corner: width scales the player, height grows the list.
    Rectangle {
        x: root.width - 9 * u; y: root.height - 9 * u; width: 9 * u; height: 9 * u;
        for k in 3: Rectangle {
            x: (2 + k * 2.2) * u; y: (6.6 - k * 2.2) * u; width: 1.4 * u; height: 1.4 * u; border-radius: 0.3 * u; background: #00000060;
            Rectangle { x: -1px; y: -1px; width: parent.width; height: parent.height; border-radius: parent.border-radius; background: Pal.bevel-light.transparentize(40%); }
        }
        for k in 2: Rectangle {
            x: (4.2 + k * 2.2) * u; y: 6.6 * u; width: 1.4 * u; height: 1.4 * u; border-radius: 0.3 * u; background: #00000060;
            Rectangle { x: -1px; y: -1px; width: parent.width; height: parent.height; border-radius: parent.border-radius; background: Pal.bevel-light.transparentize(40%); }
        }
        TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(); } }
            // The grip moves with the corner, so the travel since the press is always the next step.
            moved => { if (root.manual-resize && self.pressed) { root.resize-by(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
        }
    }

    // ───────────────────────── Options ─────────────────────────
    options := PopupWindow {
        x: 4 * u; y: 13 * u; width: 150 * u; height: min(root.height - 16 * u, (themes.length + 6) * 9 * u + 6 * u);
        Frame {
            width: parent.width; height: parent.height;
            Flickable {
                x: 2 * u; y: 2 * u; width: parent.width - 4 * u; height: parent.height - 4 * u;
                content-height: (root.themes.length + 6) * 9 * u;
                Text { x: 3 * u; y: 1 * u; text: "LAYOUT"; color: Pal.glyph.transparentize(45%); font-size: max(7.5px, 4.6 * u); font-weight: 800; letter-spacing: 0.4 * u; }
                Rectangle {
                    y: 7 * u; height: 9 * u; width: parent.width / 2; border-radius: 1px;
                    background: full-ta.has-hover ? Pal.list-selected-back : transparent;
                    full-ta := TouchArea { clicked => { root.to-full(); } }
                    Text { x: 6 * u; y: (parent.height - self.height) / 2; text: "     Full"; font-size: max(8.5px, 5.4 * u);
                        color: full-ta.has-hover ? Pal.list-selected-text : Pal.glyph; }
                }
                Text { x: parent.width / 2 + 3 * u; y: 9 * u; text: "✓  Classic"; color: Pal.glyph-on; font-size: max(8.5px, 5.4 * u); }
                Text { x: 3 * u; y: 19 * u; text: "THEME"; color: Pal.glyph.transparentize(45%); font-size: max(7.5px, 4.6 * u); font-weight: 800; letter-spacing: 0.4 * u; }
                for t[i] in root.themes: Rectangle {
                    y: (i + 3) * 9 * u; height: 9 * u; width: parent.width; border-radius: 1px;
                    background: ta.has-hover ? Pal.list-selected-back : transparent;
                    ta := TouchArea { clicked => { root.choose-theme(t.id); } }
                    Text {
                        x: 6 * u; y: (parent.height - self.height) / 2; font-size: max(8.5px, 5.4 * u);
                        text: (t.on ? "✓  " : "     ") + t.name;
                        color: ta.has-hover ? Pal.list-selected-text : (t.on ? Pal.glyph-on : Pal.glyph);
                    }
                }
                Text { x: 3 * u; y: (root.themes.length + 3.6) * 9 * u; text: "ABOUT"; color: Pal.glyph.transparentize(45%); font-size: max(7.5px, 4.6 * u); font-weight: 800; letter-spacing: 0.4 * u; }
                Text { x: 6 * u; y: (root.themes.length + 4.5) * 9 * u; text: "Driftwave " + root.version + "  ·  Made with Slint"; color: Pal.glyph; font-size: max(8px, 5 * u); }
            }
        }
    }
}

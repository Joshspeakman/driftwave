{
  "format": "shortwave-theme",
  "version": 1,
  "id": "woodgrain",
  "name": "Woodgrain",
  "description": "A homage to the woodgrain consoles of 1977: walnut veneer, ribbed black plastic, chunky pixels and a joystick.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#1A120B",
    "surface": "#E01C1410",
    "card": "#EE141010",
    "cardStroke": "#55E07A1F",
    "control": "#E0201812",
    "controlStroke": "#66E07A1F",
    "subtle": "#33E07A1F",
    "divider": "#44E07A1F",
    "text": "#F4E6CF",
    "textSecondary": "#D4B48C",
    "textTertiary": "#9C7E5C",
    "accent": "#E07A1F",
    "accentText": "#F2A65A",
    "onAccent": "#1A120B",
    "dialog": "#20160E",
    "pane": "#100B07"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "Press Start 2P",
    "titleSize": 20,
    "titleUppercase": true
  },
  "corners": {
    "control": 0,
    "overlay": 2,
    "card": 0,
    "cover": 0
  },
  "effects": {
    "wood": {},
    "windowTitle": {
      "font": "Press Start 2P",
      "size": 10,
      "color": "#F2A65A",
      "uppercase": true
    },
    "scene": {
      "layers": [
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": "#0E0E0E"
        },
        {
          "type": "line",
          "in": "titlebar-full",
          "x": 0,
          "y": 4,
          "x2": "100%",
          "y2": 0,
          "stroke": "#202020",
          "repeat": {
            "n": 10,
            "dy": 4
          }
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": -96,
          "y": 0,
          "w": 12,
          "h": 48,
          "fill": "#D8342C"
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": -78,
          "y": 0,
          "w": 12,
          "h": 48,
          "fill": "#E8782A"
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": -60,
          "y": 0,
          "w": 12,
          "h": 48,
          "fill": "#F2C230"
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": -42,
          "y": 0,
          "w": 12,
          "h": 48,
          "fill": "#4A9A3A"
        },
        {
          "type": "pixels",
          "rows": [
            ".....RR.....",
            "....RRRR....",
            "....RRRR....",
            ".....KK.....",
            ".....KK.....",
            "KKKKKKKKKKKK",
            "KWWWWWWWWWRK",
            "KKKKKKKKKKKK"
          ],
          "palette": {
            "R": "#D8342C",
            "K": "#3A3A3A",
            "W": "#E0E0E0"
          },
          "x": 4,
          "y": 12,
          "scale": 3,
          "in": "titlebar",
          "id": "stick",
          "clickable": true
        }
      ],
      "eggs": [
        {
          "trigger": "click:stick",
          "run": "pong",
          "seconds": 12
        },
        {
          "trigger": "konami",
          "run": "pong",
          "seconds": 12
        },
        {
          "trigger": "type:adventure",
          "say": "You found the secret room. The radio is in here.",
          "seconds": 5
        }
      ]
    }
  }
}

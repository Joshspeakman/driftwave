{
  "format": "shortwave-theme",
  "version": 1,
  "id": "super-16",
  "name": "Super 16",
  "description": "A homage to the 16-bit era's grey console: soft greys, four coloured buttons and a star.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#C8C9CE",
    "surface": "#E6E4E5E9",
    "card": "#F3F3F5",
    "cardStroke": "#8A8D99",
    "control": "#E9E9EC",
    "controlStroke": "#8A8D99",
    "subtle": "#332F5BD3",
    "divider": "#A9AAB2",
    "text": "#25262E",
    "textSecondary": "#4A4C58",
    "textTertiary": "#767986",
    "accent": "#2F5BD3",
    "accentText": "#2550C0",
    "onAccent": "#FFFFFF",
    "dialog": "#EDEDF0",
    "pane": "#B9BAC0"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "Press Start 2P",
    "titleSize": 18
  },
  "corners": {
    "control": 10,
    "overlay": 12,
    "card": 14,
    "cover": 0.12
  },
  "effects": {
    "tiles": {
      "colors": [
        "#4A4D57",
        "#2E9E4F",
        "#D93D3D",
        "#3D5FD9",
        "#B8962A"
      ]
    },
    "windowTitle": {
      "font": "Press Start 2P",
      "size": 10,
      "color": "#2F5BD3"
    },
    "scene": {
      "layers": [
        {
          "type": "ellipse",
          "in": "titlebar",
          "x": -58,
          "y": 4,
          "w": 16,
          "h": 16,
          "fill": "#3D5FD9"
        },
        {
          "type": "ellipse",
          "in": "titlebar",
          "x": -76,
          "y": 16,
          "w": 16,
          "h": 16,
          "fill": "#2E9E4F"
        },
        {
          "type": "ellipse",
          "in": "titlebar",
          "x": -40,
          "y": 16,
          "w": 16,
          "h": 16,
          "fill": "#D93D3D"
        },
        {
          "type": "ellipse",
          "in": "titlebar",
          "x": -58,
          "y": 28,
          "w": 16,
          "h": 16,
          "fill": "#E8C43A"
        },
        {
          "type": "pixels",
          "rows": [
            "....Y....",
            "...YYY...",
            "YYYYYYYYY",
            ".YYYYYYY.",
            "..YYYYY..",
            ".YYY.YYY.",
            "YY.....YY"
          ],
          "palette": {
            "Y": "#E8C43A"
          },
          "x": 4,
          "y": 14,
          "scale": 3,
          "in": "titlebar",
          "id": "star",
          "clickable": true
        },
        {
          "type": "text",
          "text": "30 LIVES",
          "x": "40%",
          "y": "40%",
          "size": 20,
          "color": "#2F5BD3",
          "in": "content",
          "font": "Press Start 2P",
          "id": "lives",
          "hidden": true
        }
      ],
      "eggs": [
        {
          "trigger": "konami",
          "show": "lives",
          "seconds": 6
        },
        {
          "trigger": "click:star",
          "say": "Invincible for exactly as long as this song lasts.",
          "seconds": 5
        },
        {
          "trigger": "type:blow",
          "say": "Blowing on the cartridge never really helped. It still feels right.",
          "seconds": 5
        }
      ]
    }
  }
}

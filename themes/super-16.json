{
  "format": "shortwave-theme",
  "version": 1,
  "id": "super-16",
  "name": "Super 16",
  "description": "A homage to the 16-bit era's grey-and-purple console: soft greys, purple accents, four coloured buttons and a star.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#C9C9D4",
    "surface": "#E6E4E4EC",
    "card": "#F2F2F7",
    "cardStroke": "#7C76B8",
    "control": "#E8E8F0",
    "controlStroke": "#7C76B8",
    "subtle": "#334F43AE",
    "divider": "#A9A9BC",
    "text": "#26243A",
    "textSecondary": "#4A4766",
    "textTertiary": "#7A7896",
    "accent": "#4F43AE",
    "accentText": "#4F43AE",
    "onAccent": "#FFFFFF",
    "dialog": "#ECECF3",
    "pane": "#B8B8C6"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "Press Start 2P",
    "titleSize": 18
  },
  "corners": {
    "control": 10,
    "overlay": 12,
    "card": 14,
    "cover": 0.12
  },
  "effects": {
    "windowTitle": {
      "font": "Press Start 2P",
      "size": 10,
      "color": "#4F43AE"
    },
    "scene": {
      "layers": [
        {
          "type": "ellipse",
          "in": "titlebar",
          "x": -58,
          "y": 4,
          "w": 16,
          "h": 16,
          "fill": "#2E9E4F"
        },
        {
          "type": "ellipse",
          "in": "titlebar",
          "x": -76,
          "y": 16,
          "w": 16,
          "h": 16,
          "fill": "#3D5FD9"
        },
        {
          "type": "ellipse",
          "in": "titlebar",
          "x": -40,
          "y": 16,
          "w": 16,
          "h": 16,
          "fill": "#D93D3D"
        },
        {
          "type": "ellipse",
          "in": "titlebar",
          "x": -58,
          "y": 28,
          "w": 16,
          "h": 16,
          "fill": "#E8C43A"
        },
        {
          "type": "pixels",
          "rows": [
            "....Y....",
            "...YYY...",
            "YYYYYYYYY",
            ".YYYYYYY.",
            "..YYYYY..",
            ".YYY.YYY.",
            "YY.....YY"
          ],
          "palette": {
            "Y": "#E8C43A"
          },
          "x": 4,
          "y": 14,
          "scale": 3,
          "in": "titlebar",
          "id": "star",
          "clickable": true
        },
        {
          "type": "text",
          "text": "30 LIVES",
          "x": "40%",
          "y": "40%",
          "size": 20,
          "color": "#4F43AE",
          "in": "content",
          "font": "Press Start 2P",
          "id": "lives",
          "hidden": true
        }
      ],
      "eggs": [
        {
          "trigger": "konami",
          "show": "lives",
          "seconds": 6
        },
        {
          "trigger": "click:star",
          "say": "Invincible for exactly as long as this song lasts.",
          "seconds": 5
        },
        {
          "trigger": "type:blow",
          "say": "Blowing on the cartridge never really helped. It still feels right.",
          "seconds": 5
        }
      ]
    }
  }
}

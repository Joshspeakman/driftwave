{
  "format": "shortwave-theme",
  "version": 1,
  "id": "big-glass",
  "name": "Big Glass",
  "description": "A homage to today's Mac: full frosted glass over a soft wallpaper, a menu bar, a floating dock and generous corners.",
  "base": "light",
  "backdrop": "acrylic",
  "colors": {
    "background": "#10F4F6FB",
    "surface": "#26FFFFFF",
    "card": "#55FFFFFF",
    "cardStroke": "#44FFFFFF",
    "control": "#44FFFFFF",
    "controlStroke": "#55FFFFFF",
    "subtle": "#22FFFFFF",
    "divider": "#33000000",
    "text": "#1D1D1F",
    "textSecondary": "#3C3C43",
    "textTertiary": "#6E6E73",
    "accent": "#0A84FF",
    "accentText": "#0066CC",
    "onAccent": "#FFFFFF",
    "dialog": "#EEF7F7FA"
  },
  "fonts": {
    "body": "Segoe UI Variable Text",
    "title": "Segoe UI Variable Display",
    "titleSize": 34,
    "titleWeight": "Bold"
  },
  "corners": {
    "control": 10,
    "overlay": 14,
    "card": 18,
    "cover": 0.22
  },

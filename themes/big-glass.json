          "type": "text",
          "text": "hello",
          "x": "34%",
          "y": "28%",
          "size": 96,
          "color": "#E6FFFFFF",
          "font": "Segoe Script",
          "id": "hello",
          "hidden": true,
          "in": "content"
        }
      ],
      "eggs": [
        {
          "trigger": "type:hello",
          "show": "hello",
          "seconds": 6
        },
        {
          "trigger": "click:trash",
          "say": "Nothing to empty. Driftwave never throws a song away unless you ask.",
          "seconds": 5
        },
        {
          "trigger": "konami",
          "say": "One more thing: it's still playing.",
          "seconds": 5
        }
      ]
    }

{
  "format": "shortwave-theme",
  "version": 1,
  "id": "big-glass",
  "name": "Big Glass",
  "description": "A homage to today's Mac: frosted glass over a California coast at sunset (a real photograph).",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#1A1420",
    "surface": "#4D161220",
    "card": "#73201828",
    "cardStroke": "#33FFFFFF",
    "control": "#33FFFFFF",
    "controlStroke": "#44FFFFFF",
    "subtle": "#22FFFFFF",
    "divider": "#33FFFFFF",
    "text": "#FFFFFF",
    "textSecondary": "#E6E1EC",
    "textTertiary": "#B5ADC2",
    "accent": "#0A84FF",
    "accentText": "#64B5FF",
    "onAccent": "#FFFFFF",
    "dialog": "#EE1E1A26",
    "pane": "#661A1420"
  },
  "fonts": {
    "body": "Segoe UI Variable Text",
    "title": "Segoe UI Variable Display",
    "titleSize": 34,
    "titleWeight": "Bold"
  },
  "corners": {
    "control": 10,
    "overlay": 14,
    "card": 18,
    "cover": 0.22
  },
  "effects": {
    "windowTitle": {
      "font": "Segoe UI Variable Text",
      "size": 13,
      "weight": "bold",
      "color": "#FFFFFF"
    },
    "scene": {
      "surfaces": "translucent",
      "layers": [
        {
          "type": "image",
          "src": "photo-coast.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#88000000",
            "#00000000"
          ]
        },
        {
          "type": "text",
          "text": "File    Edit    View    Station    Window    Help",
          "x": 4,
          "y": 15,
          "size": 13,
          "color": "#F2FFFFFF",
          "in": "titlebar",
          "font": "Segoe UI Variable Text",
          "weight": "semibold"
        },
        {
          "type": "text",
          "text": "hello",
          "x": "34%",
          "y": "28%",
          "size": 96,
          "color": "#E6FFFFFF",
          "in": "content",
          "font": "Segoe Script",
          "id": "hello",
          "hidden": true
        }
      ],
      "eggs": [
        {
          "trigger": "type:hello",
          "show": "hello",
          "seconds": 6
        },
        {
          "trigger": "konami",
          "say": "One more thing: it's still playing.",
          "seconds": 5
        }
      ]
    },
    "chrome": {
      "captions": "mac",
      "center": true
    }
  }
}

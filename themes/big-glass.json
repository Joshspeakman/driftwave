          "color": "#1D1D1F",
          "font": "Segoe UI Variable Text",
          "weight": "semibold",
          "in": "titlebar"
        },
        {
          "type": "text",
          "text": "{date}  {time}",
          "x": -330,
          "y": 15,
          "size": 13,
          "color": "#1D1D1F",
          "font": "Segoe UI Variable Text",
          "in": "titlebar"
        },
        {

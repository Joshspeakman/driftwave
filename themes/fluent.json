{
  "format": "shortwave-theme",
  "version": 1,
  "id": "fluent",
  "name": "Fluent",
  "description": "A homage to Windows 11: a soft blue bloom of light behind rounded, gently translucent surfaces.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#071022",
    "surface": "#59101828",
    "card": "#801C2438",
    "cardStroke": "#22FFFFFF",
    "control": "#33FFFFFF",
    "controlStroke": "#33FFFFFF",
    "subtle": "#1AFFFFFF",
    "divider": "#22FFFFFF",
    "text": "#FFFFFF",
    "textSecondary": "#D0D6E6",
    "textTertiary": "#9AA3B8",
    "accent": "#4CC2FF",
    "accentText": "#99DCFF",
    "onAccent": "#002033",
    "dialog": "#EE1C2233",
    "pane": "#8C0B1426"
  },
  "fonts": {
    "body": "Segoe UI Variable Text",
    "title": "Segoe UI Variable Display",
    "titleSize": 30,
    "titleWeight": "SemiBold"
  },
  "corners": {
    "control": 4,
    "overlay": 8,
    "card": 8,
    "cover": 0.16
  },
  "effects": {
    "windowTitle": {
      "font": "Segoe UI Variable Text",
      "size": 12,
      "color": "#FFFFFF"
    },
    "scene": {
      "surfaces": "translucent",
      "layers": [
        {
          "type": "image",
          "src": "fluent-bloom.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#55000000",
            "#00000000"
          ]
        }
      ],
      "eggs": [
        {
          "trigger": "konami",
          "say": "Recommended: keep listening.",
          "seconds": 5
        }
      ]
    }
  }
}

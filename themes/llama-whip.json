{
  "format": "shortwave-theme",
  "version": 1,
  "id": "llama-whip",
  "name": "Llama Whip",
  "description": "A homage to the classic MP3 player of 1997: brushed gunmetal, a gold title strip, an LCD readout and spectrum bars.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#1C1C24",
    "surface": "#CC23232B",
    "card": "#E62A2A33",
    "cardStroke": "#55D4AF37",
    "control": "#E6303038",
    "controlStroke": "#66D4AF37",
    "subtle": "#3300E000",
    "divider": "#44D4AF37",
    "text": "#D8D8E0",
    "textSecondary": "#A8A8B4",
    "textTertiary": "#76768A",
    "accent": "#00E000",
    "accentText": "#D4AF37",
    "onAccent": "#000000",
    "dialog": "#24242C",
    "pane": "#E615151B"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "VT323",
    "titleSize": 34,
    "titleUppercase": true,
    "lcd": "VT323"
  },
  "corners": {
    "control": 0,
    "overlay": 2,
    "card": 2,
    "cover": 0
  },
  "effects": {
    "lcd": {
      "color": "#00E000",
      "background": "#050805"
    },
    "analyzer": {},
    "windowTitle": {
      "font": "Segoe UI",
      "size": 12,
      "weight": "bold",
      "color": "#D4AF37",
      "uppercase": true
    },
    "scene": {
      "layers": [
        {
          "type": "image",
          "src": "llama-metal.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "image",
          "src": "llama-gold.jpg",
          "in": "titlebar",
          "x": 0,
          "y": 19,
          "h": 10,
          "fit": "fill",
          "id": "strip",
          "clickable": true
        }
      ],
      "eggs": [
        {
          "trigger": "click:strip",
          "say": "It really whips the llama's... well. You know the rest.",
          "seconds": 6
        },
        {
          "trigger": "type:llama",
          "say": "It really whips the llama's... well. You know the rest.",
          "seconds": 6
        }
      ]
    }
  }
}

{
  "format": "shortwave-theme",
  "version": 1,
  "id": "llama-whip",
  "name": "Llama Whip",
  "description": "A homage to the classic MP3 player of 1997: a black-and-gold skin, an LCD readout, spectrum bars and a llama.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#1C1C24",
    "surface": "#E623232B",
    "card": "#EE2A2A33",
    "cardStroke": "#55D4AF37",
    "control": "#E6303038",
    "controlStroke": "#66D4AF37",
    "subtle": "#3300E000",
    "divider": "#44D4AF37",
    "text": "#D8D8E0",
    "textSecondary": "#A8A8B4",
    "textTertiary": "#76768A",
    "accent": "#00E000",
    "accentText": "#D4AF37",
    "onAccent": "#000000",
    "dialog": "#24242C",
    "pane": "#15151B"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "VT323",
    "titleSize": 34,
    "titleUppercase": true,
    "lcd": "VT323"
  },
  "corners": {
    "control": 0,
    "overlay": 2,
    "card": 2,
    "cover": 0
  },
  "effects": {
    "lcd": {
      "color": "#00E000",
      "background": "#050805"
    },
    "analyzer": {},
    "scene": {
      "layers": [
        {
          "type": "rect",
          "in": "titlebar",
          "x": 128,
          "y": 18,
          "w": -380,
          "h": 12,
          "fill": [
            [
              "#6E5A1E",
              0
            ],
            [
              "#D4AF37",
              0.5
            ],
            [
              "#6E5A1E",
              1
            ]
          ]
        },
        {
          "type": "line",
          "in": "titlebar",
          "x": 128,
          "y": 20,
          "x2": -380,
          "y2": 0,
          "stroke": "#3A2E0C",
          "repeat": {
            "n": 4,
            "dy": 2
          }
        },
        {
          "type": "rect",
          "x": "40%",
          "y": 12,
          "w": 150,
          "h": 24,
          "fill": "#1C1C24",
          "in": "titlebar"
        },
        {
          "type": "text",
          "text": "DRIFTWAVE 2.0",
          "x": "41%",
          "y": 13,
          "size": 20,
          "color": "#D4AF37",
          "font": "VT323",
          "in": "titlebar"
        },
        {
          "type": "pixels",
          "rows": [
            "..KK..........",
            "..KWK.........",
            "..KWWK........",
            ".KWWWK........",
            "KWKWWK........",
            ".KWWWK........",
            "..KWWK........",
            "..KWWK........",
            "..KWWWKKKKKK..",
            "..KWWWWWWWWWK.",
            "..KWWWWWWWWWWK",
            "..KWWWWWWWWWK.",
            "..KWWKKKKWWK..",
            "..KWK....KWK..",
            "..KWK....KWK..",
            "..KKK....KKK.."
          ],
          "palette": {
            "K": "#000000",
            "W": "#FFFFFF"
          },
          "x": -90,
          "y": -90,
          "scale": 4,
          "in": "content",
          "id": "llama",
          "clickable": true
        },
        {
          "type": "pixels",
          "rows": [
            "KKKKKKKKKKKKKKKK",
            "KWWWWWWWWWWWWWWK",
            "KWRRRRRRRRRRRRWK",
            "KWWWWWWWWWWWWWWK",
            "KWWKKKWWWWKKKWWK",
            "KWKWWWKWWKWWWKWK",
            "KWWKKKWWWWKKKWWK",
            "KWWWWWWWWWWWWWWK",
            "KWWWKKKKKKKKWWWK",
            "KKKKKKKKKKKKKKKK"
          ],
          "palette": {
            "K": "#000000",
            "W": "#FFFFFF",
            "R": "#D4AF37"
          },
          "x": 20,
          "y": -60,
          "scale": 3,
          "in": "content"
        },
        {
          "type": "text",
          "text": "128 kbps   44 kHz   stereo",
          "x": 80,
          "y": -50,
          "size": 16,
          "color": "#00E000",
          "font": "VT323",
          "in": "content"
        },
        {
          "type": "pixels",
          "rows": [
            "..KK..........",
            "..KWK.........",
            "..KWWK........",
            ".KWWWK........",
            "KWKWWK........",
            ".KWWWK........",
            "..KWWK........",
            "..KWWK........",
            "..KWWWKKKKKK..",
            "..KWWWWWWWWWK.",
            "..KWWWWWWWWWWK",
            "..KWWWWWWWWWK.",
            "..KWWKKKKWWK..",
            "..KWK....KWK..",
            "..KWK....KWK..",
            "..KKK....KKK.."
          ],
          "palette": {
            "K": "#000000",
            "W": "#FFFFFF"
          },
          "x": -60,
          "y": -80,
          "scale": 3,
          "in": "content",
          "id": "walker",
          "hidden": true
        }
      ],
      "eggs": [
        {
          "trigger": "click:llama",
          "say": "It really whips the llama's... well. You know the rest.",
          "seconds": 6
        },
        {
          "trigger": "type:llama",
          "run": "walk:walker",
          "seconds": 8
        },
        {
          "trigger": "konami",
          "run": "walk:walker",
          "seconds": 8
        }
      ]
    }
  }
}

{
  "format": "shortwave-theme",
  "version": 1,
  "id": "sixteen-blast",
  "name": "Sixteen Blast",
  "description": "A homage to the black 16-bit console that did what the others didn't: glossy black, red and gold, speed lines.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#0A0A0C",
    "surface": "#E6101014",
    "card": "#EE16161C",
    "cardStroke": "#55E8262B",
    "control": "#E01A1A20",
    "controlStroke": "#66E8262B",
    "subtle": "#33E8262B",
    "divider": "#44E8262B",
    "text": "#F2F2F2",
    "textSecondary": "#BDBDC6",
    "textTertiary": "#80808C",
    "accent": "#E8262B",
    "accentText": "#FF5A5E",
    "onAccent": "#FFFFFF",
    "dialog": "#141418",
    "pane": "#050506"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "Orbitron",
    "titleSize": 28,
    "titleWeight": "Black",
    "titleUppercase": true,
    "titleSpacing": 60
  },
  "corners": {
    "control": 2,
    "overlay": 4,
    "card": 4,
    "cover": 0.06
  },
  "effects": {
    "titleShadow": {
      "color": "#E8262B",
      "blur": 0,
      "offsetX": 2,
      "offsetY": 2
    },
    "windowTitle": {
      "font": "Orbitron",
      "size": 12,
      "weight": "bold",
      "color": "#FFD24A",
      "uppercase": true
    },
    "scene": {
      "layers": [
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#1E1E24",
            "#050506"
          ]
        },
        {
          "type": "text",
          "text": "16-BIT",
          "x": 4,
          "y": 12,
          "size": 18,
          "color": "#E8262B",
          "in": "titlebar",
          "font": "Orbitron",
          "weight": "black",
          "id": "badge",
          "clickable": true
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": 120,
          "h": 2,
          "fill": [
            "#00FFFFFF",
            "#55FFFFFF"
          ],
          "angle": "h",
          "scatter": {
            "n": 14,
            "seed": 3,
            "w": "100%",
            "h": 44
          }
        },
        {
          "type": "text",
          "text": "BLAST PROCESSING ENGAGED",
          "x": "26%",
          "y": "42%",
          "size": 22,
          "color": "#FFD24A",
          "in": "content",
          "font": "Orbitron",
          "weight": "black",
          "id": "blast",
          "hidden": true
        }
      ],
      "eggs": [
        {
          "trigger": "type:blast",
          "show": "blast",
          "seconds": 5
        },
        {
          "trigger": "click:badge",
          "show": "blast",
          "seconds": 5
        },
        {
          "trigger": "konami",
          "say": "Level select unlocked: every station is level 1.",
          "seconds": 6
        }
      ]
    }
  }
}

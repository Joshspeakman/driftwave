{
  "format": "shortwave-theme",
  "version": 1,
  "id": "night-market",
  "name": "Night Market",
  "description": "A rainy night in Tokyo's neon streets (a real photograph of Kabukichō) with rain falling over it.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#05070C",
    "surface": "#8C070A12",
    "card": "#A60B111C",
    "cardStroke": "#3337E0FF",
    "control": "#B3111A28",
    "controlStroke": "#4437E0FF",
    "subtle": "#2237E0FF",
    "divider": "#2237E0FF",
    "text": "#F2F4FF",
    "textSecondary": "#B8C4DC",
    "textTertiary": "#7A869E",
    "accent": "#FF4F8B",
    "accentText": "#4FE3FF",
    "onAccent": "#05070C",
    "dialog": "#F00B111C",
    "pane": "#A6070A12"
  },
  "fonts": {
    "body": "Yu Gothic UI",
    "title": "Yu Gothic UI",
    "titleSize": 30,
    "titleWeight": "Bold",
    "titleSpacing": 60
  },
  "corners": {
    "control": 2,
    "overlay": 4,
    "card": 4,
    "cover": 0.06
  },
  "effects": {
    "windowTitle": {
      "font": "Yu Gothic UI",
      "size": 13,
      "weight": "bold",
      "color": "#FFFFFF"
    },
    "vignette": {
      "opacity": 0.4
    },
    "titleShadow": {
      "color": "#FF4F8B",
      "blur": 14
    },
    "scene": {
      "surfaces": "translucent",
      "layers": [
        {
          "type": "image",
          "src": "photo-night-market.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#B3000000",
            "#00000000"
          ]
        },
        {
          "type": "image",
          "src": "rain-far.png",
          "in": "window",
          "x": 0,
          "y": 0,
          "loopY": 1.7,
          "tile": 512,
          "opacity": 0.45
        },
        {
          "type": "image",
          "src": "rain-near.png",
          "in": "window",
          "x": 0,
          "y": 0,
          "loopY": 0.75,
          "tile": 512,
          "opacity": 0.65
        },
        {
          "type": "text",
          "text": "夜市 ・ 雨",
          "x": 4,
          "y": 12,
          "size": 16,
          "color": "#FF8FB8",
          "in": "titlebar",
          "font": "Yu Gothic UI",
          "weight": "bold",
          "glow": "#FF4F8B",
          "glowRadius": 2
        },
        {
          "type": "text",
          "text": "二つで十分ですよ！",
          "x": "30%",
          "y": "44%",
          "size": 26,
          "color": "#FFFFFF",
          "in": "content",
          "font": "Yu Gothic UI",
          "weight": "bold",
          "glow": "#FF4F8B",
          "id": "two",
          "hidden": true
        }
      ],
      "eggs": [
        {
          "trigger": "type:noodles",
          "show": "two",
          "say": "Four bowls? Two is enough.",
          "seconds": 6
        },
        {
          "trigger": "idle:120",
          "say": "The rain never stops here. Neither does the radio.",
          "seconds": 6
        }
      ]
    }
  }
}

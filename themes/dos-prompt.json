{
  "format": "shortwave-theme",
  "version": 1,
  "id": "dos-prompt",
  "name": "C:\\ Prompt",
  "description": "A homage to DOS: grey text on black, yellow on blue, a prompt in the title bar and box-drawn borders.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#000000",
    "surface": "#000000",
    "card": "#0000AA",
    "cardStroke": "#AAAAAA",
    "control": "#0000AA",
    "controlStroke": "#AAAAAA",
    "subtle": "#33AAAAAA",
    "divider": "#555555",
    "text": "#AAAAAA",
    "textSecondary": "#AAAAAA",
    "textTertiary": "#555555",
    "accent": "#FFFF55",
    "accentText": "#FFFF55",
    "onAccent": "#000000",
    "dialog": "#0000AA",
    "pane": "#000000"
  },
  "fonts": {
    "body": "Consolas",
    "title": "VT323",
    "titleSize": 34,
    "titleUppercase": true
  },
  "corners": {
    "control": 0,
    "overlay": 0,
    "card": 0,
    "cover": 0
  },
  "effects": {
    "tiles": {
      "colors": [
        "#0000AA",
        "#AA5500",
        "#00AA00"
      ],
      "flat": true
    },
    "cursor": {
      "color": "#AAAAAA"
    },
    "scanlines": {
      "opacity": 0.08
    },
    "windowTitle": {
      "font": "VT323",
      "size": 20,
      "color": "#AAAAAA",
      "uppercase": true
    },
    "scene": {
      "layers": [
        {
          "type": "text",
          "text": "C:\\>_",
          "x": 6,
          "y": 12,
          "size": 22,
          "color": "#AAAAAA",
          "in": "titlebar",
          "font": "VT323"
        },
        {
          "type": "pixels",
          "rows": [
            "KKKKKKKKK",
            ".KWWWWWK.",
            "..KYYYK..",
            "...KYK...",
            "....K....",
            "...KWK...",
            "..KWYWK..",
            ".KYYYYYK.",
            "KKKKKKKKK"
          ],
          "palette": {
            "K": "#AAAAAA",
            "W": "#555555",
            "Y": "#FFFF55"
          },
          "x": 64,
          "y": 12,
          "scale": 3,
          "in": "titlebar"
        }
      ],
      "eggs": [
        {
          "trigger": "type:dir",
          "say": " Volume in drive C is DRIFTWAVE\n LIBRARY  <DIR>\n COVERS   <DIR>\n SONGS    <DIR>\n        3 dir(s)  plenty free",
          "seconds": 7
        },
        {
          "trigger": "type:ver",
          "say": "Driftwave Version 1.0 Beta 1",
          "seconds": 4
        },
        {
          "trigger": "type:help",
          "say": "DIR  VER  HELP  and one secret involving arrows.",
          "seconds": 5
        },
        {
          "trigger": "type:format",
          "say": "Nice try.",
          "seconds": 3
        },
        {
          "trigger": "konami",
          "run": "pong",
          "seconds": 12
        }
      ]
    },
    "visTint": {
      "back": "#000000",
      "ink": "#FFFF55"
    }
  }
}

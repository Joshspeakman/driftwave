{
  "format": "shortwave-theme",
  "version": 1,
  "id": "superbar",
  "name": "Superbar",
  "description": "A homage to Windows 7: clear glass over a deep blue swoosh of light.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#0A2550",
    "surface": "#550A1E3A",
    "card": "#801A3A60",
    "cardStroke": "#5580B8E8",
    "control": "#55183A5A",
    "controlStroke": "#6680B8E8",
    "subtle": "#3380B8E8",
    "divider": "#4480B8E8",
    "text": "#FFFFFF",
    "textSecondary": "#CFE2F5",
    "textTertiary": "#93AFCB",
    "accent": "#2E8BE6",
    "accentText": "#8CC7FF",
    "onAccent": "#00142A",
    "dialog": "#E6142A44",
    "pane": "#80081A33"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "Segoe UI",
    "titleSize": 28
  },
  "corners": {
    "control": 3,
    "overlay": 6,
    "card": 6,
    "cover": 0.1
  },
  "effects": {
    "windowTitle": {
      "font": "Segoe UI",
      "size": 13,
      "color": "#FFFFFF"
    },
    "scene": {
      "surfaces": "translucent",
      "layers": [
        {
          "type": "image",
          "src": "superbar.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#66000000",
            "#00000000"
          ]
        },
        {
          "type": "radial",
          "in": "titlebar",
          "x": 0,
          "y": 6,
          "w": 36,
          "h": 36,
          "fill": [
            [
              "#FFFFFFFF",
              0
            ],
            [
              "#FF2E8BE6",
              0.45
            ],
            [
              "#FF0B3C7A",
              1
            ]
          ],
          "id": "orb",
          "clickable": true
        }
      ],
      "eggs": [
        {
          "trigger": "click:orb",
          "say": "Pinned to the superbar: Driftwave. Of course.",
          "seconds": 5
        },
        {
          "trigger": "type:shake",
          "say": "You'd shake a window to clear the others away. Here, everything stays.",
          "seconds": 5
        }
      ]
    }
  }
}

{
  "format": "shortwave-theme",
  "version": 1,
  "id": "superbar",
  "name": "Superbar",
  "description": "A homage to Windows 7: clear glass, a blue swoosh of light, and a superbar with pinned favourites.",
  "base": "dark",
  "backdrop": "acrylic",
  "colors": {
    "background": "#331C3F66",
    "surface": "#22000000",
    "card": "#44123355",
    "cardStroke": "#5580B8E8",
    "control": "#44183A5A",
    "controlStroke": "#6680B8E8",
    "subtle": "#3380B8E8",
    "divider": "#4480B8E8",
    "text": "#FFFFFF",
    "textSecondary": "#CFE2F5",
    "textTertiary": "#93AFCB",
    "accent": "#2E8BE6",
    "accentText": "#8CC7FF",
    "onAccent": "#00142A",
    "dialog": "#E6142A44"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "Segoe UI",
    "titleSize": 28
  },
  "corners": {
    "control": 3,
    "overlay": 6,
    "card": 6,
    "cover": 0.1
  },
  "effects": {
    "scene": {
      "layers": [
        {
          "type": "rect",
          "in": "content",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": "100%",
          "fill": [
            [
              "#0E3F75",
              0
            ],
            [
              "#1A6FB8",
              0.55
            ],
            [
              "#0B2D57",
              1
            ]
          ]
        },
        {
          "type": "radial",
          "in": "content",
          "x": "-10%",
          "y": "35%",
          "w": "120%",
          "h": "40%",
          "fill": [
            [
              "#AA8FD4FF",
              0
            ],
            [
              "#334AA3E8",
              0.45
            ],
            [
              "#00000000",
              1
            ]
          ],
          "motion": {
            "kind": "drift",
            "x": 30,
            "y": -10,
            "seconds": 30
          }
        },
        {
          "type": "radial",
          "in": "content",
          "x": "30%",
          "y": "50%",
          "w": "90%",
          "h": "25%",
          "fill": [
            [
              "#88B7F0FF",
              0
            ],
            [
              "#00000000",
              1
            ]
          ],
          "motion": {
            "kind": "drift",
            "x": -24,
            "y": 8,
            "seconds": 36
          }
        },
        {
          "type": "rect",
          "in": "content",
          "x": 0,
          "y": -40,
          "w": "100%",
          "h": 40,
          "fill": [
            [
              "#AA4F7FB0",
              0
            ],
            [
              "#CC123050",
              1
            ]
          ],
          "stroke": "#5580B8E8"
        },
        {
          "type": "radial",
          "in": "content",
          "x": 8,
          "y": -38,
          "w": 36,
          "h": 36,
          "fill": [
            [
              "#FFFFFFFF",
              0
            ],
            [
              "#FF2E8BE6",
              0.45
            ],
            [
              "#FF0B3C7A",
              1
            ]
          ],
          "id": "orb",
          "clickable": true
        },
        {
          "type": "rect",
          "in": "content",
          "x": 56,
          "y": -38,
          "w": 54,
          "h": 36,
          "fill": "#334F9BE0",
          "radius": 3,
          "stroke": "#6680B8E8"
        },
        {
          "type": "pixels",
          "rows": [
            "....KKKK",
            "....KYYK",
            "....K..K",
            "....K..K",
            "....K..K",
            "KKKKK..K",
            "KYYYK..K",
            "KYYYKKKK",
            "KKKKKYYK",
            "....KKKK"
          ],
          "palette": {
            "K": "#000000",
            "Y": "#FFFFFF"
          },
          "x": 74,
          "y": -32,
          "scale": 3,
          "in": "content"
        },
        {
          "type": "rect",
          "in": "content",
          "x": 114,
          "y": -38,
          "w": 54,
          "h": 36,
          "fill": "#22FFFFFF",
          "radius": 3
        },
        {
          "type": "pixels",
          "rows": [
            "..KKKKK.......",
            ".KYYYYYK......",
            "KKKKKKKKKKKKKK",
            "KYYYYYYYYYYYYK",
            "KYWWWWWWWWWWYK",
            "KYYYYYYYYYYYYK",
            "KYYYYYYYYYYYYK",
            "KYYYYYYYYYYYYK",
            "KDDDDDDDDDDDDK",
            "KKKKKKKKKKKKKK"
          ],
          "palette": {
            "K": "#000000",
            "W": "#FFFFFF",
            "Y": "#F3C55B",
            "D": "#C28F1F"
          },
          "x": 122,
          "y": -34,
          "scale": 3,
          "in": "content"
        },
        {
          "type": "text",
          "text": "{time}\n{date}",
          "x": -96,
          "y": -38,
          "size": 11,
          "color": "#FFFFFF",
          "font": "Segoe UI",
          "in": "content"
        }
      ],
      "eggs": [
        {
          "trigger": "click:orb",
          "say": "Pinned to the superbar: Driftwave. Of course.",
          "seconds": 5
        },
        {
          "trigger": "type:shake",
          "say": "You'd shake a window to clear the others away. Here, everything stays.",
          "seconds": 5
        }
      ]
    }
  }
}

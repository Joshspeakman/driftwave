{
  "format": "shortwave-theme",
  "version": 1,
  "id": "luna",
  "name": "Luna",
  "description": "A homage to Windows XP: rolling green hills under a big blue sky, a glossy blue title bar and a green go button.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#245EDC",
    "surface": "#33FFFFFF",
    "card": "#EEF3FB",
    "cardStroke": "#7A96DF",
    "control": "#F4F7FD",
    "controlStroke": "#7A96DF",
    "subtle": "#333C7FE0",
    "divider": "#ACA899",
    "text": "#000000",
    "textSecondary": "#2A2A2A",
    "textTertiary": "#6A6A6A",
    "accent": "#245EDC",
    "accentText": "#0B3FB0",
    "onAccent": "#FFFFFF",
    "dialog": "#ECE9D8",
    "pane": "#D6DFF7"
  },
  "fonts": {
    "body": "Tahoma",
    "title": "Trebuchet MS",
    "titleSize": 28,
    "titleWeight": "Bold"
  },
  "corners": {
    "control": 3,
    "overlay": 6,
    "card": 8,
    "cover": 0.1
  },
  "effects": {
    "scene": {
      "layers": [
        {
          "type": "rect",
          "in": "titlebar",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            [
              "#0A58E2",
              0
            ],
            [
              "#3A93FF",
              0.12
            ],
            [
              "#0053E1",
              0.5
            ],
            [
              "#0044C8",
              1
            ]
          ]
        },
        {
          "type": "text",
          "text": "Driftwave",
          "x": 130,
          "y": 12,
          "size": 17,
          "color": "#FFFFFF",
          "font": "Trebuchet MS",
          "weight": "bold",
          "in": "titlebar"
        },
        {
          "type": "rect",
          "in": "content",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": "100%",
          "fill": [
            [
              "#3F86E8",
              0
            ],
            [
              "#8EC3F7",
              0.55
            ],
            [
              "#BFE0FA",
              0.62
            ],
            [
              "#5DAA2E",
              0.63
            ],
            [
              "#2F7A12",
              1
            ]
          ]
        },
        {
          "type": "radial",
          "in": "content",
          "x": "-20%",
          "y": "58%",
          "w": "90%",
          "h": "60%",
          "fill": [
            [
              "#7CC24A",
              0
            ],
            [
              "#4E9A22",
              0.7
            ],
            [
              "#00000000",
              1
            ]
          ]
        },
        {
          "type": "radial",
          "in": "content",
          "x": "40%",
          "y": "55%",
          "w": "80%",
          "h": "60%",
          "fill": [
            [
              "#86CC52",
              0
            ],
            [
              "#3E8B1C",
              0.75
            ],
            [
              "#00000000",
              1
            ]
          ]
        },
        {
          "type": "ellipse",
          "in": "content",
          "x": "10%",
          "y": "12%",
          "w": 140,
          "h": 40,
          "fill": "#E8F4FFFF",
          "opacity": 0.85,
          "motion": {
            "kind": "drift",
            "x": 60,
            "seconds": 40
          }
        },
        {
          "type": "ellipse",
          "in": "content",
          "x": "15%",
          "y": "9%",
          "w": 90,
          "h": 46,
          "fill": "#F2F9FFFF",
          "opacity": 0.85,
          "motion": {
            "kind": "drift",
            "x": 60,
            "seconds": 40
          }
        },
        {
          "type": "ellipse",
          "in": "content",
          "x": "55%",
          "y": "22%",
          "w": 120,
          "h": 34,
          "fill": "#EAF5FFFF",
          "opacity": 0.7,
          "motion": {
            "kind": "drift",
            "x": -50,
            "seconds": 52
          }
        },
        {
          "type": "rect",
          "in": "content",
          "x": 0,
          "y": -30,
          "w": "100%",
          "h": 30,
          "fill": [
            [
              "#3168D5",
              0
            ],
            [
              "#245EDC",
              0.5
            ],
            [
              "#1941A5",
              1
            ]
          ]
        },
        {
          "type": "rect",
          "in": "content",
          "x": 0,
          "y": -30,
          "w": 96,
          "h": 30,
          "fill": [
            [
              "#4FB33F",
              0
            ],
            [
              "#3C9A3C",
              0.5
            ],
            [
              "#2E7D2C",
              1
            ]
          ],
          "radius": 0,
          "id": "go",
          "clickable": true
        },
        {
          "type": "text",
          "text": "start",
          "x": 22,
          "y": -26,
          "size": 17,
          "color": "#FFFFFF",
          "font": "Trebuchet MS",
          "weight": "bold",
          "style": "italic",
          "in": "content"
        },
        {
          "type": "rect",
          "in": "content",
          "x": -96,
          "y": -30,
          "w": 96,
          "h": 30,
          "fill": [
            [
              "#0F8FEE",
              0
            ],
            [
              "#0A6CC7",
              1
            ]
          ]
        },
        {
          "type": "text",
          "text": "{time}",
          "x": -80,
          "y": -24,
          "size": 12,
          "color": "#FFFFFF",
          "font": "Tahoma",
          "in": "content"
        },
        {
          "type": "rect",
          "in": "content",
          "x": -300,
          "y": -110,
          "w": 260,
          "h": 64,
          "fill": "#FFFFE1",
          "stroke": "#000000",
          "radius": 8,
          "id": "balloon",
          "hidden": true
        },
        {
          "type": "text",
          "text": "New radio found\nClick here to keep listening.",
          "x": -288,
          "y": -100,
          "size": 12,
          "color": "#000000",
          "font": "Tahoma",
          "id": "balloon",
          "hidden": true,
          "in": "content"
        }
      ],
      "eggs": [
        {
          "trigger": "click:go",
          "say": "Start ▸ All Programs ▸ Driftwave. Good call.",
          "seconds": 5
        },
        {
          "trigger": "idle:90",
          "show": "balloon",
          "seconds": 7
        },
        {
          "trigger": "type:bliss",
          "say": "Somewhere a hill is still this green.",
          "seconds": 5
        }
      ]
    }
  }
}

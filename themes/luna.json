{
  "format": "shortwave-theme",
  "version": 1,
  "id": "luna",
  "name": "Luna",
  "description": "A homage to Windows XP: green hills under a big blue sky (a real photograph), a glossy blue title bar.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#245EDC",
    "surface": "#66F4F8FF",
    "card": "#D9EEF3FB",
    "cardStroke": "#7A96DF",
    "control": "#F4F7FD",
    "controlStroke": "#7A96DF",
    "subtle": "#333C7FE0",
    "divider": "#ACA899",
    "text": "#000000",
    "textSecondary": "#2A2A2A",
    "textTertiary": "#5A5A5A",
    "accent": "#245EDC",
    "accentText": "#0B3FB0",
    "onAccent": "#FFFFFF",
    "dialog": "#ECE9D8",
    "pane": "#C6D3F5FF"
  },
  "fonts": {
    "body": "Tahoma",
    "title": "Trebuchet MS",
    "titleSize": 28,
    "titleWeight": "Bold"
  },
  "corners": {
    "control": 3,
    "overlay": 6,
    "card": 8,
    "cover": 0.1
  },
  "effects": {
    "tiles": {"colors": ["#245EDC", "#3C9A3C", "#D98A1B", "#2D7FD6"]},
    "windowTitle": {
      "font": "Trebuchet MS",
      "size": 14,
      "weight": "bold",
      "color": "#FFFFFF"
    },
    "scene": {
      "surfaces": "translucent",
      "frost": false,
      "layers": [
        {
          "type": "image",
          "src": "photo-hills.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#00000000",
            "#00000000"
          ]
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            [
              "#0A58E2",
              0
            ],
            [
              "#3A93FF",
              0.12
            ],
            [
              "#0053E1",
              0.5
            ],
            [
              "#0044C8",
              1
            ]
          ]
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": 0,
          "y": 9,
          "w": 90,
          "h": 30,
          "fill": [
            [
              "#5FC24E",
              0
            ],
            [
              "#3C9A3C",
              0.5
            ],
            [
              "#2E7D2C",
              1
            ]
          ],
          "radius": 6,
          "id": "go",
          "clickable": true
        },
        {
          "type": "text",
          "text": "start",
          "x": 18,
          "y": 11,
          "size": 17,
          "color": "#FFFFFF",
          "in": "titlebar",
          "font": "Trebuchet MS",
          "weight": "bold",
          "style": "italic"
        }
      ],
      "eggs": [
        {
          "trigger": "click:go",
          "say": "Start ▸ All Programs ▸ Driftwave. Good call.",
          "seconds": 5
        },
        {
          "trigger": "idle:90",
          "say": "New radio found. Click here to keep listening.",
          "seconds": 7
        },
        {
          "trigger": "type:bliss",
          "say": "Somewhere a hill is still this green.",
          "seconds": 5
        }
      ]
    }
  }
}

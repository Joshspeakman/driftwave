{
  "format": "shortwave-theme",
  "version": 1,
  "id": "program-manager",
  "name": "Program Manager",
  "description": "A homage to Windows 3.1: a white workspace, a solid navy title bar, crisp grey bevels.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#C0C0C0",
    "surface": "#FFFFFF",
    "card": "#FFFFFF",
    "cardStroke": "#000000",
    "control": "#C0C0C0",
    "controlStroke": "#000000",
    "subtle": "#330000A8",
    "divider": "#808080",
    "text": "#000000",
    "textSecondary": "#202020",
    "textTertiary": "#606060",
    "accent": "#000080",
    "accentText": "#000080",
    "onAccent": "#FFFFFF",
    "dialog": "#FFFFFF",
    "pane": "#FFFFFF"
  },
  "fonts": {
    "body": "Microsoft Sans Serif",
    "title": "Microsoft Sans Serif",
    "titleSize": 22,
    "titleWeight": "Bold"
  },
  "corners": {
    "control": 0,
    "overlay": 0,
    "card": 0,
    "cover": 0
  },
  "effects": {
    "tiles": {
      "colors": [
        "#000080",
        "#008080",
        "#808080"
      ],
      "flat": true
    },
    "frame": {
      "color": "#000080",
      "thickness": 4
    },
    "windowTitle": {
      "font": "Microsoft Sans Serif",
      "size": 13,
      "weight": "bold",
      "color": "#FFFFFF"
    },
    "scene": {
      "layers": [
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": "#000080"
        }
      ],
      "eggs": [
        {
          "trigger": "type:solitaire",
          "run": "cascade",
          "seconds": 9
        },
        {
          "trigger": "type:win",
          "say": "C:\\> win  -- starting Driftwave for Workgroups...",
          "seconds": 5
        }
      ]
    },
    "chrome": {
      "captions": "win31",
      "bevel": true,
      "selection": "#000080",
      "selectionText": "#FFFFFF",
      "center": true
    }
  }
}

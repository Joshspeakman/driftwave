  "backdrop": "acrylic",
  "colors": {
    "background": "#12F4F7FB",
    "surface": "#33FFFFFF",
    "card": "#6BFFFFFF",
    "cardStroke": "#80FFFFFF",
    "control": "#99FFFFFF",
    "controlStroke": "#26000000",
    "subtle": "#14000000",
    "divider": "#40FFFFFF",
    "text": "#1B2330",
    "textSecondary": "#4A5568",
    "textTertiary": "#7A8496",
    "accent": "#4F8EF7",
    "accentText": "#2F6FD8",
    "onAccent": "#FFFFFF",
    "dialog": "#EEF4F7FB"

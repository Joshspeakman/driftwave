{
  "format": "shortwave-theme",
  "version": 1,
  "id": "retrowave",
  "name": "Retrowave",
  "description": "A midnight drive: a molten orange sun sinking into an electric-blue grid.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#070B1F",
    "surface": "#B30C1433",
    "card": "#B3121D45",
    "cardStroke": "#552F7BFF",
    "control": "#CC18264F",
    "controlStroke": "#66FF7A33",
    "subtle": "#332F7BFF",
    "divider": "#442F7BFF",
    "text": "#EEF2FF",
    "textSecondary": "#A9B6DC",
    "textTertiary": "#6F7CA3",
    "accent": "#FF6A2B",
    "accentText": "#FFA55C",
    "onAccent": "#070B1F",
    "dialog": "#0E1636"
  },
  "fonts": {
    "title": "Orbitron",
    "titleSize": 30,
    "titleWeight": "Bold",
    "titleUppercase": true,
    "titleSpacing": 80
  },
  "corners": {
    "control": 2,
    "overlay": 4,
    "card": 6,
    "cover": 0.08
  },
  "effects": {
    "synthwave": {
      "sunTop": "#FFE066",
      "sunBottom": "#FF5A1F",
      "grid": "#2F7BFF",
      "sky": "#10225C"
    },
    "titleShadow": {
      "color": "#2F7BFF",
      "blur": 16
    },
    "scanlines": {
      "opacity": 0.1
    }
  }
}

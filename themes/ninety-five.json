{
  "format": "shortwave-theme",
  "version": 1,
  "id": "ninety-five",
  "name": "Ninety-Five",
  "description": "A homage to Windows 95: a teal desktop, grey 3D windows, and a navy-to-blue title bar.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#008080",
    "surface": "#00008080",
    "card": "#C0C0C0",
    "cardStroke": "#000000",
    "control": "#C0C0C0",
    "controlStroke": "#000000",
    "subtle": "#330000A8",
    "divider": "#808080",
    "text": "#000000",
    "textSecondary": "#222222",
    "textTertiary": "#555555",
    "accent": "#000080",
    "accentText": "#000080",
    "onAccent": "#FFFFFF",
    "dialog": "#C0C0C0",
    "pane": "#C0C0C0"
  },
  "fonts": {
    "body": "Microsoft Sans Serif",
    "title": "Microsoft Sans Serif",
    "titleSize": 22,
    "titleWeight": "Bold"
  },
  "corners": {
    "control": 0,
    "overlay": 0,
    "card": 0,
    "cover": 0
  },
  "effects": {
    "tiles": {
      "colors": [
        "#000080",
        "#800000",
        "#800080",
        "#808000"
      ],
      "flat": true
    },
    "windowTitle": {
      "font": "Tahoma",
      "size": 11,
      "weight": "bold",
      "color": "#FFFFFF"
    },
    "scene": {
      "layers": [
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": "#000080"
        },
        {
          "type": "bevel",
          "in": "titlebar",
          "x": 0,
          "y": 10,
          "w": 66,
          "h": 28,
          "fill": "#C0C0C0",
          "id": "start",
          "clickable": true
        },
        {
          "type": "text",
          "text": "Start",
          "x": 22,
          "y": 14,
          "size": 13,
          "color": "#000000",
          "in": "titlebar",
          "font": "Microsoft Sans Serif",
          "weight": "bold"
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": 8,
          "y": 17,
          "w": 6,
          "h": 6,
          "fill": "#FF0000"
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": 14,
          "y": 17,
          "w": 6,
          "h": 6,
          "fill": "#00A000"
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": 8,
          "y": 23,
          "w": 6,
          "h": 6,
          "fill": "#0000FF"
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": 14,
          "y": 23,
          "w": 6,
          "h": 6,
          "fill": "#FFD800"
        },
        {
          "type": "bevel",
          "in": "titlebar",
          "x": -84,
          "y": 10,
          "w": 82,
          "h": 28,
          "fill": "#C0C0C0",
          "style": "sunken"
        },
        {
          "type": "text",
          "text": "{time}",
          "x": -70,
          "y": 14,
          "size": 12,
          "color": "#000000",
          "in": "titlebar",
          "font": "Microsoft Sans Serif"
        },
        {
          "type": "text",
          "text": "It's now safe to turn off your computer.",
          "x": "18%",
          "y": "40%",
          "size": 26,
          "color": "#FF8C1A",
          "in": "content",
          "font": "Microsoft Sans Serif",
          "weight": "bold",
          "id": "safe",
          "hidden": true
        }
      ],
      "eggs": [
        {
          "trigger": "click:start",
          "say": "Start ▸ Programs ▸ Accessories ▸ Entertainment ▸ Driftwave. You're already here.",
          "seconds": 6
        },
        {
          "trigger": "type:shutdown",
          "show": "safe",
          "seconds": 6
        },
        {
          "trigger": "type:clouds",
          "say": "Somewhere a blue sky full of clouds is waiting behind every window.",
          "seconds": 5
        }
      ]
    },
    "chrome": {
      "captions": "win95",
      "bevel": true,
      "selection": "#000080",
      "selectionText": "#FFFFFF"
    }
  }
}

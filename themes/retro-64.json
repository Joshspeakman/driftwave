{
  "format": "shortwave-theme",
  "version": 1,
  "id": "retro-64",
  "name": "Retro 64",
  "description": "Light blue border, deep blue screen and a block cursor. After the Commodore 64.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#1E3488",
    "surface": "#1E3488",
    "card": "#27409A",
    "cardStroke": "#5A7BD8",
    "control": "#27409A",
    "controlStroke": "#5A7BD8",
    "subtle": "#405A7BD8",
    "divider": "#5A7BD8",
    "text": "#A6B8F2",
    "textSecondary": "#869DE0",
    "textTertiary": "#5A7BD8",
    "accent": "#5A7BD8",
    "accentText": "#C2D0FF",
    "onAccent": "#0F1D52",
    "dialog": "#1E3488"
  },
  "fonts": {
    "body": "Consolas",
    "title": "Press Start 2P",
    "titleSize": 22,
    "titleUppercase": true
  },
  "corners": {
    "control": 0,
    "overlay": 0,
    "card": 0,
    "cover": 0
  },
  "effects": {
    "frame": {
      "color": "#5A7BD8",
      "thickness": 14
    },
    "cursor": {
      "color": "#A6B8F2"
    },
    "scanlines": {
      "opacity": 0.16
    }
  }
}

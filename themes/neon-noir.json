{
  "format": "shortwave-theme",
  "version": 1,
  "id": "neon-noir",
  "name": "Neon Noir",
  "description": "Rain, amber neon and cyan haze in a city that never sees the sun. After Blade Runner.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#070A10",
    "surface": "#A60B1018",
    "card": "#B3121A24",
    "cardStroke": "#3300E5FF",
    "control": "#CC16202C",
    "controlStroke": "#4400E5FF",
    "subtle": "#2600E5FF",
    "divider": "#3300E5FF",
    "text": "#E6EEF2",
    "textSecondary": "#8FA7B3",
    "textTertiary": "#5A6B75",
    "accent": "#FF8A1E",
    "accentText": "#FFB347",
    "onAccent": "#070A10",
    "dialog": "#0D131B"
  },
  "fonts": {
    "title": "Share Tech Mono",
    "titleSize": 30,
    "titleUppercase": true,
    "titleSpacing": 240
  },
  "corners": {
    "control": 2,
    "overlay": 2,
    "card": 4,
    "cover": 0.04
  },
  "effects": {
    "rain": {
      "color": "#9FD8FF",
      "drops": 90,
      "glowA": "#FF8A1E",
      "glowB": "#00E5FF"
    },
    "titleShadow": {
      "color": "#00E5FF",
      "blur": 14
    },
    "grain": {
      "opacity": 0.05
    },
    "vignette": {
      "opacity": 0.5
    }
  }
}

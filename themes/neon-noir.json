{
  "format": "shortwave-theme",
  "version": 1,
  "id": "neon-noir",
  "name": "Neon Noir",
  "description": "Rain over a real neon street at night in Tokyo, amber and steel blue, behind smoky glass.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#070A10",
    "surface": "#8C0B1018",
    "card": "#A6111820",
    "cardStroke": "#334A90FF",
    "control": "#CC16202C",
    "controlStroke": "#444A90FF",
    "subtle": "#264A90FF",
    "divider": "#334A90FF",
    "text": "#E6EEF2",
    "textSecondary": "#8FA7B3",
    "textTertiary": "#5A6B75",
    "accent": "#FF8A1E",
    "accentText": "#FFB347",
    "onAccent": "#070A10",
    "dialog": "#0D131B",
    "pane": "#A6070A10"
  },
  "fonts": {
    "title": "Share Tech Mono",
    "titleSize": 30,
    "titleUppercase": true,
    "titleSpacing": 240
  },
  "corners": {
    "control": 2,
    "overlay": 2,
    "card": 4,
    "cover": 0.04
  },
  "effects": {
    "titleShadow": {
      "color": "#4A90FF",
      "blur": 14
    },
    "grain": {
      "opacity": 0.05
    },
    "vignette": {
      "opacity": 0.5
    },
    "windowTitle": {
      "font": "Share Tech Mono",
      "size": 14,
      "color": "#9CC2FF",
      "uppercase": true
    },
    "scene": {
      "surfaces": "translucent",
      "layers": [
        {
          "type": "image",
          "src": "photo-neon-noir.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#B3000000",
            "#00000000"
          ]
        },
        {
          "type": "image",
          "src": "rain-far.png",
          "in": "window",
          "x": 0,
          "y": 0,
          "loopY": 3.2,
          "tile": 512,
          "opacity": 0.5
        },
        {
          "type": "image",
          "src": "rain-near.png",
          "in": "window",
          "x": 0,
          "y": 0,
          "loopY": 1.6,
          "tile": 512,
          "opacity": 0.7
        }
      ]
    }
  }
}

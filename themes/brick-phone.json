{
  "format": "shortwave-theme",
  "version": 1,
  "id": "brick-phone",
  "name": "Brick Phone",
  "description": "A homage to the indestructible phones of 1999: a green backlit LCD, chunky pixels, signal bars and a snake.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#8FA87A",
    "surface": "#E6C7F0A8",
    "card": "#D8B6DE8E",
    "cardStroke": "#43523D",
    "control": "#C7F0A8",
    "controlStroke": "#43523D",
    "subtle": "#3343523D",
    "divider": "#43523D",
    "text": "#2B3627",
    "textSecondary": "#43523D",
    "textTertiary": "#5E7356",
    "accent": "#43523D",
    "accentText": "#2B3627",
    "onAccent": "#C7F0A8",
    "dialog": "#C7F0A8",
    "pane": "#9DB689"
  },
  "fonts": {
    "body": "Consolas",
    "title": "VT323",
    "titleSize": 36
  },
  "corners": {
    "control": 0,
    "overlay": 2,
    "card": 2,
    "cover": 0
  },
  "effects": {
    "windowTitle": {
      "font": "VT323",
      "size": 20,
      "color": "#2B3627"
    },
    "scene": {
      "layers": [
        {
          "type": "line",
          "in": "window",
          "x": 0,
          "y": 0,
          "x2": "100%",
          "y2": 0,
          "stroke": "#1443523D",
          "repeat": {
            "n": 400,
            "dy": 3
          }
        },
        {
          "type": "pixels",
          "rows": [
            "......KK",
            "......KK",
            "....KKKK",
            "....KKKK",
            "..KKKKKK",
            "..KKKKKK",
            "KKKKKKKK",
            "KKKKKKKK"
          ],
          "palette": {
            "K": "#2B3627"
          },
          "x": 4,
          "y": 15,
          "scale": 2,
          "in": "titlebar",
          "id": "phone",
          "clickable": true
        },
        {
          "type": "pixels",
          "rows": [
            "KKKKKKKKKKKK.",
            "KGGGGGGGGGGKK",
            "KGGGGGGGGGGKK",
            "KGGGGGGGGGGKK",
            "KKKKKKKKKKKK."
          ],
          "palette": {
            "K": "#2B3627",
            "G": "#43523D"
          },
          "x": -34,
          "y": 18,
          "scale": 2,
          "in": "titlebar"
        }
      ],
      "eggs": [
        {
          "trigger": "type:snake",
          "run": "snake",
          "seconds": 20
        },
        {
          "trigger": "click:phone",
          "say": "1 missed call: your favourite station.",
          "seconds": 5
        },
        {
          "trigger": "konami",
          "run": "snake",
          "seconds": 20
        }
      ]
    }
  }
}

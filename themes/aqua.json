{
  "format": "shortwave-theme",
  "version": 1,
  "id": "aqua",
  "name": "Aqua",
  "description": "A homage to Mac OS X: water-blue light, pinstripes and glossy gel.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#0E5AC2",
    "surface": "#99F5F7FA",
    "card": "#E6FFFFFF",
    "cardStroke": "#9FB3CC",
    "control": "#F3F6FA",
    "controlStroke": "#8EA4C0",
    "subtle": "#33479BE8",
    "divider": "#C5CED9",
    "text": "#111111",
    "textSecondary": "#3A3F47",
    "textTertiary": "#6A717B",
    "accent": "#1F7CE8",
    "accentText": "#1366CC",
    "onAccent": "#FFFFFF",
    "dialog": "#F4F6F9",
    "pane": "#B3E8EDF3"
  },
  "fonts": {
    "body": "Lucida Sans Unicode",
    "title": "Lucida Sans Unicode",
    "titleSize": 24,
    "titleWeight": "Bold"
  },
  "corners": {
    "control": 10,
    "overlay": 8,
    "card": 10,
    "cover": 0.18
  },
  "effects": {
    "windowTitle": {
      "font": "Lucida Sans Unicode",
      "size": 13,
      "weight": "bold",
      "color": "#FFFFFF"
    },
    "scene": {
      "surfaces": "translucent",
      "frost": false,
      "layers": [
        {
          "type": "image",
          "src": "aqua.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#55000000",
            "#00000000"
          ]
        },
        {
          "type": "line",
          "in": "window",
          "x": 0,
          "y": 0,
          "x2": "100%",
          "y2": 0,
          "stroke": "#10FFFFFF",
          "repeat": {
            "n": 400,
            "dy": 4
          }
        }
      ],
      "eggs": [
        {
          "trigger": "type:lick",
          "say": "Lickable. (Please don't.)",
          "seconds": 5
        }
      ]
    },
    "chrome": {
      "captions": "mac",
      "center": true
    }
  }
}

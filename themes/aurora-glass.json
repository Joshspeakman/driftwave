{
  "format": "shortwave-theme",
  "version": 1,
  "id": "aurora-glass",
  "name": "Aurora Glass",
  "description": "A homage to Windows Vista: smoky glass over a real aurora, with a soft glow on everything.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#020A12",
    "surface": "#66081620",
    "card": "#8C0E1A28",
    "cardStroke": "#5582C8FF",
    "control": "#66203040",
    "controlStroke": "#6682C8FF",
    "subtle": "#3382C8FF",
    "divider": "#4482C8FF",
    "text": "#FFFFFF",
    "textSecondary": "#C8DCF0",
    "textTertiary": "#8FA8C0",
    "accent": "#3FA0E8",
    "accentText": "#7FC8FF",
    "onAccent": "#00121F",
    "dialog": "#E6101C28",
    "pane": "#8C06101A"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "Segoe UI Light",
    "titleSize": 32
  },
  "corners": {
    "control": 4,
    "overlay": 6,
    "card": 6,
    "cover": 0.08
  },
  "effects": {
    "windowTitle": {
      "font": "Segoe UI",
      "size": 13,
      "color": "#FFFFFF"
    },
    "scene": {
      "surfaces": "translucent",
      "layers": [
        {
          "type": "image",
          "src": "photo-aurora.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#99000000",
            "#00000000"
          ]
        },
        {
          "type": "radial",
          "in": "titlebar",
          "x": 0,
          "y": 6,
          "w": 36,
          "h": 36,
          "fill": [
            [
              "#DDFFFFFF",
              0
            ],
            [
              "#883FA0E8",
              0.5
            ],
            [
              "#00000000",
              1
            ]
          ],
          "id": "orb",
          "clickable": true
        }
      ],
      "eggs": [
        {
          "trigger": "click:orb",
          "say": "The wow starts... whenever you press play.",
          "seconds": 5
        },
        {
          "trigger": "type:wow",
          "say": "Wow.",
          "seconds": 3
        }
      ]
    }
  }
}

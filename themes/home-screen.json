{
  "format": "shortwave-theme",
  "version": 1,
  "id": "home-screen",
  "name": "Home Screen",
  "description": "A homage to the phone in your pocket: a soft glowing wallpaper behind rounded glass.",
  "base": "dark",
  "backdrop": "none",
  "colors": {
    "background": "#2A1840",
    "surface": "#4D10101C",
    "card": "#73FFFFFF",
    "cardStroke": "#33FFFFFF",
    "control": "#59101018",
    "controlStroke": "#44FFFFFF",
    "subtle": "#22FFFFFF",
    "divider": "#33FFFFFF",
    "text": "#FFFFFF",
    "textSecondary": "#F0ECF4",
    "textTertiary": "#C8C0D2",
    "accent": "#0A84FF",
    "accentText": "#64D2FF",
    "onAccent": "#FFFFFF",
    "dialog": "#EE1C1C2A",
    "pane": "#59100A1C"
  },
  "fonts": {
    "body": "Segoe UI Variable Text",
    "title": "Segoe UI Variable Display",
    "titleSize": 34,
    "titleWeight": "Bold"
  },
  "corners": {
    "control": 14,
    "overlay": 18,
    "card": 22,
    "cover": 0.26
  },
  "effects": {
    "windowTitle": {
      "font": "Segoe UI Variable Text",
      "size": 13,
      "weight": "bold",
      "color": "#FFFFFF"
    },
    "scene": {
      "surfaces": "translucent",
      "layers": [
        {
          "type": "image",
          "src": "home-screen.jpg",
          "in": "window",
          "x": 0,
          "y": 0
        },
        {
          "type": "rect",
          "in": "titlebar-full",
          "x": 0,
          "y": 0,
          "w": "100%",
          "h": 48,
          "fill": [
            "#55000000",
            "#00000000"
          ]
        },
        {
          "type": "rect",
          "in": "titlebar",
          "x": "40%",
          "y": 9,
          "w": 120,
          "h": 30,
          "fill": "#000000",
          "radius": 15,
          "id": "island",
          "clickable": true
        },
        {
          "type": "text",
          "text": "{time24}",
          "x": 8,
          "y": 14,
          "size": 15,
          "color": "#FFFFFF",
          "in": "titlebar",
          "font": "Segoe UI Variable Text",
          "weight": "semibold"
        }
      ],
      "eggs": [
        {
          "trigger": "click:island",
          "say": "Now playing lives here too.",
          "seconds": 4
        },
        {
          "trigger": "type:slide",
          "say": "slide to unlock ▸▸",
          "seconds": 5
        }
      ]
    }
  }
}

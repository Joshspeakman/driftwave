{
  "format": "shortwave-theme",
  "version": 1,
  "id": "platinum",
  "name": "Platinum",
  "description": "A homage to classic Mac OS: platinum grey, pinstriped title bars, a smiling computer and a desk full of folders.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#DDDDDD",
    "surface": "#F2EEEEEE",
    "card": "#FFFFFF",
    "cardStroke": "#000000",
    "control": "#EEEEEE",
    "controlStroke": "#555555",
    "subtle": "#33666699",
    "divider": "#999999",
    "text": "#000000",
    "textSecondary": "#262626",
    "textTertiary": "#666666",
    "accent": "#666699",
    "accentText": "#333399",
    "onAccent": "#FFFFFF",
    "dialog": "#EEEEEE",
    "pane": "#E4E4E4"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "Segoe UI Semibold",
    "titleSize": 22
  },
  "corners": {
    "control": 3,
    "overlay": 2,
    "card": 2,
    "cover": 0.04
  },
  "effects": {
    "scene": {
      "layers": [
        {
          "type": "line",
          "in": "titlebar",
          "x": 130,
          "y": 14,
          "x2": -330,
          "y2": 0,
          "stroke": "#9A9A9A",
          "repeat": {
            "n": 7,
            "dy": 3
          }
        },
        {
          "type": "rect",
          "x": "44%",
          "y": 10,
          "w": 120,
          "h": 26,
          "fill": "#DDDDDD",
          "in": "titlebar"
        },
        {
          "type": "text",
          "text": "Driftwave",
          "x": "45%",
          "y": 13,
          "size": 14,
          "color": "#000000",
          "font": "Segoe UI Semibold",
          "in": "titlebar"
        },
        {
          "type": "pixels",
          "rows": [
            "KKKKKKKKKKKK",
            "KWWWWWWWWWWK",
            "KWKKKKKKKKWK",
            "KWKWWWWWWKWK",
            "KWKWKWWKWKWK",
            "KWKWWWWWWKWK",
            "KWKWKWWKWKWK",
            "KWKWWKKWWKWK",
            "KWKWWWWWWKWK",
            "KWKKKKKKKKWK",
            "KWWWWWWWWWWK",
            "KWWWWWKKKKWK",
            "KWWWWWWWWWWK",
            "KKKKKKKKKKKK"
          ],
          "palette": {
            "K": "#000000",
            "W": "#FFFFFF"
          },
          "x": -110,
          "y": 20,
          "scale": 3,
          "in": "content",
          "id": "hd",
          "clickable": true
        },
        {
          "type": "text",
          "text": "Macintosh HD",
          "x": -116,
          "y": 66,
          "size": 11,
          "color": "#000000",
          "font": "Segoe UI",
          "in": "content"
        },
        {
          "type": "pixels",
          "rows": [
            "..KKKKK.......",
            ".KYYYYYK......",
            "KKKKKKKKKKKKKK",
            "KYYYYYYYYYYYYK",
            "KYWWWWWWWWWWYK",
            "KYYYYYYYYYYYYK",
            "KYYYYYYYYYYYYK",
            "KYYYYYYYYYYYYK",
            "KDDDDDDDDDDDDK",
            "KKKKKKKKKKKKKK"
          ],
          "palette": {
            "K": "#000000",
            "W": "#FFFFFF",
            "Y": "#FFD34E",
            "D": "#B08A2E"
          },
          "x": -110,
          "y": 100,
          "scale": 3,
          "in": "content"
        },
        {
          "type": "text",
          "text": "Radio Folder",
          "x": -116,
          "y": 134,
          "size": 11,
          "color": "#000000",
          "font": "Segoe UI",
          "in": "content"
        },
        {
          "type": "pixels",
          "rows": [
            "...KKKKKK...",
            "KKKKKKKKKKKK",
            "KWWWWWWWWWWK",
            ".KWGWGWGWGK.",
            ".KWGWGWGWGK.",
            ".KWGWGWGWGK.",
            ".KWGWGWGWGK.",
            ".KWGWGWGWGK.",
            ".KWWWWWWWWK.",
            "..KKKKKKKK.."
          ],
          "palette": {
            "K": "#000000",
            "W": "#FFFFFF",
            "G": "#C0C0C0"
          },
          "x": -104,
          "y": -80,
          "scale": 3,
          "in": "content"
        },
        {
          "type": "text",
          "text": "Trash",
          "x": -110,
          "y": -46,
          "size": 11,
          "color": "#000000",
          "font": "Segoe UI",
          "in": "content"
        },
        {
          "type": "rect",
          "in": "content",
          "x": "20%",
          "y": "30%",
          "w": 280,
          "h": 90,
          "fill": "#EEEEEE",
          "stroke": "#000000",
          "id": "welcome",
          "hidden": true
        },
        {
          "type": "text",
          "text": "Welcome to Driftwave.",
          "x": "23%",
          "y": "36%",
          "size": 20,
          "color": "#000000",
          "font": "Segoe UI Semibold",
          "id": "welcome",
          "hidden": true,
          "in": "content"
        }
      ],
      "eggs": [
        {
          "trigger": "konami",
          "show": "welcome",
          "seconds": 6
        },
        {
          "trigger": "click:hd",
          "say": "About This Radio: built-in memory? Plenty. Largest unused block: all of it.",
          "seconds": 6
        },
        {
          "trigger": "type:sosumi",
          "say": "Sosumi. (Some sounds have stories.)",
          "seconds": 5
        }
      ]
    }
  }
}

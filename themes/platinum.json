{
  "format": "shortwave-theme",
  "version": 1,
  "id": "platinum",
  "name": "Platinum",
  "description": "A homage to classic Mac OS: platinum grey, a pinstriped title bar, and calm, crisp black type.",
  "base": "light",
  "backdrop": "none",
  "colors": {
    "background": "#DDDDDD",
    "surface": "#F2EEEEEE",
    "card": "#FFFFFF",
    "cardStroke": "#000000",
    "control": "#EEEEEE",
    "controlStroke": "#555555",
    "subtle": "#335B7299",
    "divider": "#999999",
    "text": "#000000",
    "textSecondary": "#262626",
    "textTertiary": "#666666",
    "accent": "#5B7299",
    "accentText": "#2E4F99",
    "onAccent": "#FFFFFF",
    "dialog": "#EEEEEE",
    "pane": "#E4E4E4"
  },
  "fonts": {
    "body": "Segoe UI",
    "title": "Segoe UI Semibold",
    "titleSize": 22
  },
  "corners": {
    "control": 3,
    "overlay": 2,
    "card": 2,
    "cover": 0.04
  },
  "effects": {
    "tiles": {
      "colors": [
        "#6F86B0",
        "#5F8EB0",
        "#8E8E8E"
      ]
    },
    "windowTitle": {
      "font": "Segoe UI Semibold",
      "size": 13,
      "color": "#000000"
    },
    "scene": {
      "layers": [
        {
          "type": "image",
          "src": "platinum.jpg",
          "in": "window",
          "x": 0,
          "y": 0,
          "opacity": 0.9
        },
        {
          "type": "line",
          "in": "titlebar-full",
          "x": 34,
          "y": 15,
          "x2": -84,
          "y2": 0,
          "stroke": "#9A9A9A",
          "repeat": {
            "n": 7,
            "dy": 3
          }
        },
        {
          "type": "text",
          "text": "Welcome to Driftwave.",
          "x": "20%",
          "y": "38%",
          "size": 22,
          "color": "#000000",
          "in": "content",
          "font": "Segoe UI Semibold",
          "id": "welcome",
          "hidden": true
        }
      ],
      "eggs": [
        {
          "trigger": "konami",
          "show": "welcome",
          "seconds": 6
        },
        {
          "trigger": "type:sosumi",
          "say": "Sosumi. (Some sounds have stories.)",
          "seconds": 5
        }
      ]
    },
    "chrome": {
      "captions": "platinum",
      "center": true,
      "plate": "#DDDDDD",
      "bevel": true,
      "bevelLight": "#FFFFFF",
      "bevelHi": "#EEEEEE",
      "bevelShadow": "#AAAAAA",
      "bevelDark": "#555555",
      "platePad": 8
    }
  }
}

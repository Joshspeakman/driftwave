<UserControl
    x:Class="Shortwave.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shortwave.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="24,12,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Search" Style="{StaticResource PageTitleStyle}" />
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search stations" QueryIcon="Find" MaxWidth="420"
                            HorizontalAlignment="Right" Width="360" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search stations" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="24,0,16,8">
                <ComboBox x:Name="OrderBox" Width="150" SelectionChanged="Filter_Changed" ToolTipService.ToolTip="Sort results" AutomationProperties.Name="Sort" />
                <ComboBox x:Name="CountryBox" Width="190" SelectionChanged="Filter_Changed" AutomationProperties.Name="Country" />
                <ComboBox x:Name="LanguageBox" Width="170" SelectionChanged="Filter_Changed" AutomationProperties.Name="Language" />
                <ComboBox x:Name="TagBox" Width="160" SelectionChanged="Filter_Changed" AutomationProperties.Name="Tag" />
                <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" Visibility="Collapsed" />
                <TextBlock x:Name="CountText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420" Padding="24">
                <FontIcon x:Name="PlaceholderGlyph" Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="PlaceholderTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="PlaceholderText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="RetryButton" Content="Try Again" HorizontalAlignment="Center" Click="Retry_Click" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="LoadingState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <ProgressRing IsActive="True" />
                <TextBlock Text="Searching…" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <ScrollViewer x:Name="Results" Visibility="Collapsed">
                <local:StationGrid x:Name="Grid" Margin="16,4,16,16" />
            </ScrollViewer>
            <ProgressBar x:Name="TopProgress" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Margin="16,0" />
        </Grid>
    </Grid>
</UserControl>

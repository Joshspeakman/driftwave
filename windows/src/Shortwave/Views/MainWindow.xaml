<Window
    x:Class="Shortwave.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shortwave.Views">
    <!-- The Default theme's backdrop; a theme can swap it (ThemeManager.ApplyWindow) -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <!-- 48: Windows' tall caption buttons (AppWindow.TitleBar.PreferredHeightOption = Tall) -->
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Theme layers: background colour, effects behind the UI, effects in front of it (no clicks) -->
        <Border x:Name="BackdropFill" Grid.RowSpan="2" />
        <Grid x:Name="EffectsBack" Grid.RowSpan="2" IsHitTestVisible="False" />
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        OpenPaneLength="200" CompactModeThresholdWidth="900" ExpandedModeThresholdWidth="1000"
                        SelectionChanged="Nav_SelectionChanged" ItemInvoked="Nav_ItemInvoked" IsTitleBarAutoPaddingEnabled="False">
            <!-- The pane's surface: clear over Mica (Default); themes give it their own colour (MainWindow.ApplyLook), so
                 window effects stay behind the content instead of running under the menu -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Library" Tag="Library" ToolTipService.ToolTip="Library (Ctrl+1)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Discover" Tag="Discover" ToolTipService.ToolTip="Discover (Ctrl+2)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE909;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="Search" ToolTipService.ToolTip="Search (Ctrl+F)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AddStationItem" Content="Add Local Station" SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="Add a local station (Ctrl+N)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE710;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PlayerToggleItem" Content="Hide Player" SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="Show or hide the player (Ctrl+Alt+P)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE89F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MiniPlayerItem" Content="Mini Player" SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="Open the mini player (Ctrl+Shift+M)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE944;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
                    <!-- A new version was found by the check at launch -->
                    <InfoBar x:Name="UpdateBar" VerticalAlignment="Bottom" Margin="16" IsOpen="False" Severity="Informational"
                             Title="Update available" IsClosable="True" />
                    <!-- With the player hidden: the station on a floating card at the bottom -->
                    <Border x:Name="BottomBar" Grid.Row="1" Visibility="Collapsed" Margin="8,0,8,8" BorderThickness="1"
                            CornerRadius="{StaticResource ShortwaveCardRadius}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <local:MiniPlayerView />
                    </Border>
                </Grid>
                <!-- The player: a floating card beside the page (no hard divider). The outer grid slides its width when
                     the player is shown or hidden; the card keeps its width and is clipped, so it slides out whole. -->
                <Grid x:Name="PlayerPane" Grid.Column="1" Width="312">
                    <Border x:Name="PlayerCard" Width="300" HorizontalAlignment="Left" Margin="4,8,8,8" BorderThickness="1"
                            CornerRadius="{StaticResource ShortwaveCardRadius}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <local:PlayerPanel />
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
        <Grid x:Name="EffectsFront" Grid.RowSpan="2" IsHitTestVisible="False" />
    </Grid>
</Window>

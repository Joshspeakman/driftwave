<UserControl
    x:Class="Shortwave.Views.PlaybackControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="Panel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="PlayButton" Click="PlayButton_Click" Padding="0" Width="30" Height="30" CornerRadius="15"
                AutomationProperties.Name="Play" Style="{StaticResource AccentButtonStyle}">
            <Grid>
                <ProgressRing x:Name="Spinner" IsActive="False" Width="20" Height="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <FontIcon x:Name="PlayGlyph" Glyph="&#xF5B0;" FontSize="13" />
                <Rectangle x:Name="StopGlyph" Width="11" Height="11" RadiusX="2" RadiusY="2" Visibility="Collapsed" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Grid>
        </Button>
        <Button x:Name="MuteButton" Click="MuteButton_Click" Padding="4" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Mute">
            <FontIcon x:Name="MuteGlyph" Glyph="&#xE995;" FontSize="16" />
        </Button>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" Width="110" VerticalAlignment="Center"
                AutomationProperties.Name="Volume" ValueChanged="VolumeSlider_ValueChanged" IsThumbToolTipEnabled="True" />
        <DropDownButton x:Name="OutputButton" Padding="6,4" Visibility="Collapsed" AutomationProperties.Name="Audio Output"
                        Background="Transparent" BorderThickness="0">
            <FontIcon Glyph="&#xE7F3;" FontSize="16" />
            <DropDownButton.Flyout>
                <MenuFlyout x:Name="OutputMenu" Opening="OutputMenu_Opening" Placement="Bottom" />
            </DropDownButton.Flyout>
        </DropDownButton>
    </StackPanel>
</UserControl>

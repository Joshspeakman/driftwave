<UserControl
    x:Class="Shortwave.Views.StationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shortwave.Views">
    <Grid x:Name="Card" Padding="8" CornerRadius="14" Background="Transparent" Width="164"
          PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerCanceled="Card_PointerExited"
          Tapped="Card_Tapped" DoubleTapped="Card_DoubleTapped" IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="Card_KeyDown">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="Menu" Opening="Menu_Opening" />
        </Grid.ContextFlyout>
        <StackPanel Spacing="8">
            <Grid Width="148" Height="148">
                <local:StationCover x:Name="Cover" Size="148" />
                <Button x:Name="PlayButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                        Width="36" Height="36" CornerRadius="18" Padding="0" Visibility="Collapsed" Click="PlayButton_Click"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid><FontIcon x:Name="PlayGlyph" Glyph="&#xF5B0;" FontSize="14" /><Rectangle x:Name="StopGlyph" Width="11" Height="11" RadiusX="2" RadiusY="2" Visibility="Collapsed" Fill="{ThemeResource TextFillColorPrimaryBrush}" /></Grid>
                </Button>
            </Grid>
            <StackPanel Width="148" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon x:Name="ActiveIcon" Glyph="&#xE995;" FontSize="12" Visibility="Collapsed"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="NameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="148" />
                </StackPanel>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" MaxWidth="148" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

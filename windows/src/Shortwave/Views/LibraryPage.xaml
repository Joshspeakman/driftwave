<UserControl
    x:Class="Shortwave.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shortwave.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="24,12,16,8">
            <TextBlock Text="Library" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <DropDownButton x:Name="SortButton" ToolTipService.ToolTip="Sort the library" AutomationProperties.Name="Sort">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                        <TextBlock x:Name="SortLabel" Text="Sort" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SortMenu" Opening="SortMenu_Opening" Placement="BottomEdgeAlignedRight" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="MoreButton" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MoreMenu" Opening="MoreMenu_Opening" Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Import Stations…" KeyboardAcceleratorTextOverride="Ctrl+Shift+I" Click="Import_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ExportItem" Text="Export Stations…" KeyboardAcceleratorTextOverride="Ctrl+Shift+E" Click="Export_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="24">
            <FontIcon Glyph="&#xEC05;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Your Library Is Empty" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Discover over 50,000 public stations and add the ones you like." Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Content="Discover New Stations" Style="{StaticResource AccentButtonStyle}" Click="Discover_Click" />
                <Button Content="Add Local Station" Click="AddLocal_Click" />
                <Button Content="Import Stations…" Click="Import_Click" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Visibility="Collapsed">
            <local:StationGrid x:Name="Grid" Margin="16,4,16,16" />
        </ScrollViewer>
    </Grid>
</UserControl>

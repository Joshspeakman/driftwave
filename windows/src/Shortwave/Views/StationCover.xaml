<UserControl
    x:Class="Shortwave.Views.StationCover"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid x:Name="Frame" BorderThickness="0.5" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid x:Name="Fallback">
            <Grid.Background>
                <LinearGradientBrush x:Name="FallbackBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="Stop1" Offset="0" />
                    <GradientStop x:Name="Stop2" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <FontIcon x:Name="Glyph" Glyph="&#xEC05;" Foreground="#E6FFFFFF" />
        </Grid>
        <Grid x:Name="ImageHost" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Image x:Name="Picture" Stretch="Uniform" />
        </Grid>
    </Grid>
</UserControl>

<UserControl
    x:Class="Shortwave.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" Margin="24,12,16,8" Height="32" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,4,24,24" Spacing="4" MaxWidth="760" HorizontalAlignment="Stretch">
                <TextBlock Text="Playback" FontWeight="SemiBold" Margin="2,8,0,4" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Background Playback" />
                            <TextBlock Text="Playback continues when the window is closed." Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="BackgroundToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="BackgroundToggle_Toggled"
                                      AutomationProperties.Name="Background Playback" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Notifications" />
                            <TextBlock x:Name="NotificationsText" Text="Show a notification when a new track gets played." Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NotificationsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="NotificationsToggle_Toggled"
                                      AutomationProperties.Name="Notifications" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Played tracks to keep" VerticalAlignment="Center" />
                        <NumberBox x:Name="PastTracksBox" Grid.Column="1" Minimum="1" Maximum="50" SmallChange="1" LargeChange="5" Width="120"
                                   SpinButtonPlacementMode="Inline" ValueChanged="PastTracksBox_ValueChanged" AutomationProperties.Name="Played tracks to keep" />
                    </Grid>
                </Border>

                <TextBlock Text="Recording" FontWeight="SemiBold" Margin="2,20,0,4" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <RadioButtons x:Name="ModeButtons" SelectionChanged="ModeButtons_SelectionChanged" AutomationProperties.Name="Recording" />
                        <TextBlock x:Name="ModeExplanation" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Tracks are recognised from the station’s stream metadata. MP3 and AAC streams can be recorded; HLS and Ogg streams play without recording." />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="RecordingOptions" Spacing="4">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Track Folder" VerticalAlignment="Center" />
                            <TextBlock x:Name="FolderText" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button Content="Choose…" Click="ChooseFolder_Click" />
                                <Button x:Name="OpenFolderButton" Click="OpenFolder_Click" ToolTipService.ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Minimum Duration" />
                                <TextBlock Text="Tracks shorter than the minimum duration are ignored." Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="MinText" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            <NumberBox x:Name="MinBox" Grid.Column="2" Minimum="0" Maximum="600" SmallChange="5" LargeChange="30" Width="120"
                                       SpinButtonPlacementMode="Inline" ValueChanged="MinBox_ValueChanged" AutomationProperties.Name="Minimum Duration in seconds" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Maximum Duration" />
                                <TextBlock Text="Recording ends when the maximum duration is reached." Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="MaxText" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            <NumberBox x:Name="MaxBox" Grid.Column="2" Minimum="60" Maximum="7200" SmallChange="60" LargeChange="600" Width="120"
                                       SpinButtonPlacementMode="Inline" ValueChanged="MaxBox_ValueChanged" AutomationProperties.Name="Maximum Duration in seconds" />
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Text="About" FontWeight="SemiBold" Margin="2,20,0,4" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="AboutTitle" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                                   Text="Internet radio for Windows, after GNOME Shortwave by Felix Häcker and contributors. It contains none of Shortwave’s code or artwork." />
                        <HyperlinkButton Content="Station data: radio-browser.info" NavigateUri="https://www.radio-browser.info" Padding="0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl
    x:Class="Shortwave.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shortwave.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="24,12,16,8">
            <TextBlock Text="Discover" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <DropDownButton x:Name="CountryButton" ToolTipService.ToolTip="Choose the country for popular and random stations" AutomationProperties.Name="Country">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE909;" FontSize="14" />
                        <TextBlock x:Name="CountryLabel" Text="Country" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout x:Name="CountryFlyout" Placement="BottomEdgeAlignedRight" Opened="CountryFlyout_Opened">
                            <Grid Width="280" Height="420" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="CountryFilter" PlaceholderText="Filter countries" TextChanged="CountryFilter_TextChanged" />
                                <ListView x:Name="CountryList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CountryList_ItemClick" />
                            </Grid>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="RefreshButton" Click="Refresh_Click" ToolTipService.ToolTip="Show other stations" AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16,4,16,16" Spacing="28">
                <StackPanel x:Name="ErrorState" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="8" Padding="0,80,0,0" MaxWidth="420">
                    <FontIcon Glyph="&#xEB5E;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Unable to Retrieve Station Data" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Try Again" HorizontalAlignment="Center" Click="Refresh_Click" />
                </StackPanel>
                <StackPanel x:Name="LoadingState" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="8" Padding="0,120,0,0">
                    <ProgressRing IsActive="True" />
                    <TextBlock Text="Loading…" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <StackPanel x:Name="PopularSection">
                    <TextBlock x:Name="PopularTitle" Style="{StaticResource SectionTitleStyle}" />
                    <local:StationGrid x:Name="PopularGrid" />
                </StackPanel>
                <StackPanel x:Name="TrendingSection">
                    <TextBlock Text="Trending Worldwide" Style="{StaticResource SectionTitleStyle}" />
                    <local:StationGrid x:Name="TrendingGrid" />
                </StackPanel>
                <StackPanel x:Name="RandomSection">
                    <TextBlock Text="Random Stations" Style="{StaticResource SectionTitleStyle}" />
                    <local:StationGrid x:Name="RandomGrid" />
                </StackPanel>
                <StackPanel x:Name="MissingNote" Spacing="6" Padding="8,0">
                    <TextBlock Text="Add Missing Station" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="If the station you are looking for is missing, you can add it to the public database, or add it just for yourself as a local station." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="Add Public Station" NavigateUri="https://www.radio-browser.info/add" />
                        <Button Content="Add Local Station" Click="AddLocal_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
